---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import { site, footerNav, conditionHubs, areas, legal } from '../../data/site';
const year = new Date().getFullYear();
const social = [
  { name: 'Instagram', href: site.social.instagram, path: 'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.4 5.6 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.6 18.4 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6' },
  { name: 'X', href: site.social.x, path: 'M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.32l4.37 5.78L17.75 3Zm-1.08 16.18h1.7L7.4 4.74H5.58l11.09 14.44Z' },
  { name: 'LinkedIn', href: site.social.linkedin, path: 'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z' },
  { name: 'Facebook', href: site.social.facebook, path: 'M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.33-.04-1.57-.14-2.88-.14C11.9 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5Z' },
];
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__about">
        <div class="stack-13">
          <p class="footer__title">REAL CHIROPRACTIC CARE<br />IN DOWNTOWN AUSTIN</p>
          <p class="footer__blurb">Doctor-led chiropractic care in Austin's West End since 1994. Adjustments, spinal decompression, digital X-rays, pregnancy care, and auto injury treatment, with free parking off MoPac.</p>
        </div>
        <div class="footer__col footer__col--wide">
          <p class="footer__head footer__head--light">Location</p>
          <a href={site.mapsHref} target="_blank" rel="noopener" class="footer__addr"><Icon name="map-pin" size={14} />{site.addressLine}</a>
        </div>
      </div>
      <div class="footer__cols">
        <nav class="footer__col" aria-label="Footer navigation">
          <p class="footer__head">Navigation</p>
          <ul role="list">{footerNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
        <nav class="footer__col" aria-label="Conditions">
          <p class="footer__head">Conditions</p>
          <ul role="list">{conditionHubs.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
        <nav class="footer__col" aria-label="Locations">
          <p class="footer__head">Locations</p>
          <ul role="list">{areas.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
        <div class="footer__col">
          <p class="footer__head">Working Hours</p>
          <div class="footer__hours">
            <p class="footer__day">Monday – Thursday</p>
            <div class="footer__times"><p>8 AM – 1 PM</p><p>3 PM – 5 PM</p></div>
          </div>
          <hr class="footer__rule" />
          <div class="footer__hours">
            <p class="footer__day">Friday to Sunday</p>
            <p>Closed</p>
          </div>
        </div>
      </div>
    </div>

    <div class="footer__mid">
      <a href="/" aria-label="West End Chiropractic home"><Logo width={180} /></a>
      <div class="footer__contact">
        <div class="footer__col"><p class="footer__head footer__head--plain">Email us</p><a href={site.emailHref}>{site.email}</a></div>
        <div class="footer__col"><p class="footer__head footer__head--plain">Phone</p><a href={site.phoneHref}>{site.phone}</a></div>
        <div class="footer__col">
          <p class="footer__head footer__head--plain">Follow us</p>
          <div class="footer__social">
            {social.map((s) => <a href={s.href} aria-label={s.name} target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg></a>)}
          </div>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} West End Chiropractic</p>
      <ul role="list" class="footer__legal">{legal.filter((l) => /privacy|terms/i.test(l.label)).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      <p>{site.license}</p>
    </div>
  </div>
  <p class="footer__disclaimer"><strong>WEST END CHIROPRACTIC</strong> {site.disclaimer}</p>
</footer>

<style>
  .footer { background: var(--navy-900); color: var(--sand-100); }
  .footer__inner { display: flex; flex-direction: column; gap: 48px; padding-top: 60px; padding-bottom: 32px; }
  .footer__top { display: flex; flex-direction: column; gap: 60px; }
  .footer__about { display: flex; flex-direction: column; gap: 22px; max-width: 342px; }
  .stack-13 { display: flex; flex-direction: column; gap: 13px; }
  .footer__title { font-size: 20px; line-height: 26px; font-weight: 600; color: var(--white); }
  .footer__blurb { font-size: 12px; line-height: 1.5; }
  .footer__cols { display: grid; grid-template-columns: minmax(0, 180px) minmax(0, 1fr); gap: 65px 24px; }
  .footer__times { display: flex; flex-direction: column; gap: 4px; }
  .footer__addr :global(.icon) { color: var(--orange-500); }
  .footer__col { display: flex; flex-direction: column; gap: 13px; font-size: 14px; line-height: 22px; }
  .footer__col ul { display: flex; flex-direction: column; gap: 13px; list-style: none; padding: 0; }
  .footer__col a:hover { color: var(--white); text-decoration: underline; text-underline-offset: 3px; }
  .footer__head { font-size: 12px; line-height: 22px; font-weight: 700; color: var(--orange-500); padding-bottom: 6px; border-bottom: 1px solid var(--navy-line); max-width: 110px; }
  .footer__col--wide .footer__head { max-width: none; }
  .footer__head--light { color: var(--sand-100); }
  .footer__head--plain { color: var(--sand-100); border: 0; padding: 0; max-width: none; }
  .footer__addr { display: inline-flex; align-items: center; gap: 5px; font-weight: 500; color: var(--white); }
  .footer__hours { display: flex; flex-direction: column; gap: 8px; }
  .footer__day { font-size: 12px; line-height: 1.2; font-weight: 700; }
  .footer__rule { border: 0; border-top: 1px solid var(--navy-line); max-width: 110px; margin: 0; }
  .footer__mid { display: flex; flex-direction: column; gap: 60px; padding-block: 30px; border-block: 1px solid var(--navy-line); }
  .footer__contact { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
  .footer__contact > :first-child { grid-column: 1 / -1; }
  .footer__contact .footer__col { gap: 8px; }
  .footer__social { display: flex; gap: 18px; color: var(--orange-500); }
  .footer__social a:hover { color: var(--white); }
  .footer__bottom { display: flex; flex-direction: column; gap: 16px; font-size: 14px; line-height: 22px; color: var(--white); }
  .footer__bottom > p { flex: none; }
  .footer__legal { display: flex; flex-wrap: wrap; gap: 4px 20px; list-style: none; padding: 0; color: var(--sand-100); font-size: 12px; line-height: 20px; opacity: .8; }
  .footer__legal a:hover { color: var(--white); text-decoration: underline; }
  .footer__disclaimer { background: var(--navy-600); color: var(--sand-100); font-size: 11px; line-height: 1.5; text-align: center; padding: 16px var(--gutter); }

  @media (min-width: 768px) {
    .footer__cols { grid-template-columns: repeat(4, minmax(0, max-content)); gap: 65px; }
    .footer__contact { grid-template-columns: repeat(3, max-content); }
    .footer__contact > :first-child { grid-column: auto; }
    .footer__disclaimer { font-size: 12px; }
  }
  @media (min-width: 1280px) {
    .footer__inner { padding-top: 90px; padding-bottom: 40px; }
    /* Figma (1200 frame): brand 317-325px left, link row 700px right; both rows spread with space-between.
       The right block scales with the container (700/1200) so wide screens don't open a hole in the middle. */
    .footer__top { flex-direction: row; justify-content: space-between; gap: 40px; }
    .footer__about { max-width: 325px; flex: none; }
    .footer__cols { display: flex; justify-content: space-between; gap: 24px; width: 58.34%; }
    .footer__mid { flex-direction: row; align-items: center; justify-content: space-between; }
    .footer__contact { display: flex; justify-content: space-between; gap: 32px; width: 58.34%; }
    .footer__bottom { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
