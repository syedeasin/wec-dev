---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import Deco from '../ui/Deco.astro';
import img from '../../assets/images/shared/doctor-adjusting-patient-table.webp';
---
<section class="car-band">
  <!-- Figma bone vectors: per-path 15% white, rotated inside their export boxes -->
  <Deco fillOpacity={0.15} rotate={32.56} box={[1073, 1336]} style="right:-282px;top:-97px;" />
  <Deco fillOpacity={0.15} rotate={-150.57} box={[1025, 1352]} style="left:-305px;top:-436px;" />
  <div class="container">
    <div class="car-band__card">
      <div class="car-band__copy">
        <h2 class="h2 car-band__title">Been in a car accident?</h2>
        <p class="p2 car-band__text">Same-day appointments available. We work with PIP and letters of protection, so most patients pay nothing out of pocket. West End Chiropractic has treated Austin auto injury patients since 1994.</p>
        <Button variant="tertiary" href="/services-treatments/auto-accident/" class="car-band__link">Learn about auto accident care</Button>
      </div>
      <div class="car-band__media">
        <Picture quality={85} src={img} alt="Dr. Casey Morgan adjusting a patient lying face down on the treatment table" widths={[360, 540, 800, 1040, 1200]} sizes="(min-width: 1280px) 519px, (min-width: 768px) 45vw, 100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style is:global>
  .car-band { position: relative; overflow: hidden; isolation: isolate; padding-block: 100px; background: var(--gradient-primary); }
  .car-band .deco { z-index: -1; }
  .car-band__card { display: grid; gap: 24px; padding: 40px; background: var(--white); border-radius: var(--radius-xl); box-shadow: 8px 8px 12px 0 rgb(15 45 64 / 0.16); }
  .car-band__copy { display: flex; flex-direction: column; gap: 32px; }
  .car-band__title { font-weight: 600; }
  /* Figma: P2 16/1.8 in a 557px column, which gives its 3-line break */
  .car-band__text { font-weight: 500; font-size: 16px; line-height: 1.8; color: var(--navy-900); }
  .car-band__link { margin-top: auto; align-self: flex-start; }
  .car-band__media { border-radius: var(--radius-xl); overflow: hidden; background: var(--sand-200); }
  .car-band__media img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 519 / 400; }
  @media (min-width: 1024px) { .car-band__card { grid-template-columns: minmax(0, 557fr) minmax(0, 519fr); gap: 44px; } .car-band__media img { aspect-ratio: auto; min-height: 400px; } }
  @media (max-width: 1023.98px) {
    .car-band__media { order: -1; }
    .car-band__media img { aspect-ratio: 326 / 400; object-position: 58% 50%; max-height: 420px; }
  }
  @media (max-width: 767.98px) {
    .car-band { padding-block: 60px; }
    .car-band__card { padding: 8px 8px 24px; }
    .car-band__copy { padding: 8px 16px 0; gap: 16px; }
    .car-band__copy .car-band__link { margin-top: 24px; }
    .car-band__title { font-size: 24px; line-height: 1.2; }
    .car-band__media img { aspect-ratio: 326 / 400; }
  }
</style>
