---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import Deco from '../ui/Deco.astro';
import img from '../../assets/images/shared/doctor-adjusting-patient-table.webp';
---
<section class="car-band">
  <Deco opacity={0.15} style="right:-90px;top:-97px;transform:rotate(0deg)" />
  <Deco opacity={0.15} style="left:79px;top:916px;" class="hide-mobile" />
  <div class="container">
    <div class="car-band__card">
      <div class="car-band__copy">
        <h2 class="h2 car-band__title">Been in a <strong>car accident?</strong></h2>
        <p class="p2 car-band__text">Same-day appointments available. We work with PIP and letters of protection, so most patients pay nothing out of pocket. West End Chiropractic has treated Austin auto injury patients since 1994.</p>
        <Button variant="tertiary" href="/services-treatments/auto-accident/" class="car-band__link">Learn about auto accident care</Button>
      </div>
      <div class="car-band__media">
        <Picture src={img} alt="Dr. Casey Morgan adjusting a patient lying face down on the treatment table" widths={[360, 540, 800, 1040]} sizes="(min-width: 1280px) 519px, (min-width: 768px) 45vw, 100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style is:global>
  .car-band { position: relative; overflow: hidden; isolation: isolate; padding-block: 100px; background: var(--gradient-primary); }
  .car-band .deco { z-index: -1; }
  .car-band__card { display: grid; gap: 24px; padding: 40px; background: var(--white); border-radius: var(--radius-xl); box-shadow: var(--shadow-image); }
  .car-band__copy { display: flex; flex-direction: column; gap: 32px; }
  .car-band__title { font-weight: 500; }
  .car-band__title strong { font-weight: 600; }
  .car-band__text { font-weight: 500; }
  .car-band__link { margin-top: auto; align-self: flex-start; }
  .car-band__media { border-radius: var(--radius-xl); overflow: hidden; background: var(--sand-200); }
  .car-band__media img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 519 / 400; }
  @media (min-width: 1024px) { .car-band__card { grid-template-columns: minmax(0, 557px) minmax(0, 519px); justify-content: space-between; gap: 40px; } .car-band__media img { aspect-ratio: auto; min-height: 400px; } }
  @media (max-width: 1023.98px) {
    .car-band__media { order: -1; }
    .car-band__media img { aspect-ratio: 326 / 400; object-position: 58% 50%; max-height: 420px; }
  }
  @media (max-width: 767.98px) {
    .car-band { padding-block: 60px; }
    .car-band__card { padding: 8px 8px 24px; }
    .car-band__copy { padding: 8px 8px 0; gap: 16px; }
    .car-band__title { font-size: 20px; line-height: 26px; }
    .car-band__media img { aspect-ratio: 326 / 300; }
  }
</style>
