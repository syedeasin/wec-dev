---
// "Section / Location": contact list + map image linking to Google Maps.
import { Picture } from 'astro:assets';
import IconTile from '../ui/IconTile.astro';
import SpineMark from '../ui/SpineMark.astro';
import map from '../../assets/images/shared/office-map.webp';
import { site } from '../../data/site';
interface Props { title?: string; lead?: string; directions?: boolean }
const { title = 'Come see us <strong>downtown</strong>', lead, directions = false } = Astro.props;
import Button from '../ui/Button.astro';
---
<section class="section location on-dark" id="location">
  <div class="container location__inner">
    <div class="location__info">
      <h2 class="h2 location__title"><SpineMark class="location__mark" height={56} /><span set:html={title} /></h2>
      <div class="location__list">
        {lead ? <p class="location__name" set:html={lead} /> : <p class="location__name"><strong>West End</strong> Chiropractic</p>}
        <ul class="location__grid" role="list">
          <li class="contact-item"><IconTile name="map-pin" size={40} tone="orange" /><div><p class="contact-item__label">Address</p><a href={site.mapsHref} target="_blank" rel="noopener">{site.address.street},<br />{site.address.city}, {site.address.region} {site.address.postal}</a></div></li>
          <li class="contact-item"><IconTile name="phone" size={40} tone="orange" /><div><p class="contact-item__label">Phone</p><a href={site.phoneHref}>{site.phone}</a></div></li>
          <li class="contact-item"><IconTile name="clock-4" size={40} tone="orange" /><div><p class="contact-item__label">Hours</p><p>Monday–Thursday<br />8am–1pm and 3pm–5pm</p></div></li>
          <li class="contact-item"><IconTile name="mail" size={40} tone="orange" /><div><p class="contact-item__label">Email</p><a href={site.emailHref}>{site.email}</a></div></li>
        </ul>
        <hr class="location__rule" />
        {directions && <Button href={site.mapsHref} icon="navigation" blockMobile class="location__btn" target="_blank" rel="noopener">Get Directions</Button>}
        <div class="contact-item contact-item--parking"><IconTile name="circle-parking" size={40} /><p><strong>Free covered garage parking.</strong> <span class="hide-mobile-inline">No circling the block, no meters, no walking three blocks in the heat.</span></p></div>
      </div>
    </div>
    <a class="location__map" href={site.mapsHref} target="_blank" rel="noopener" aria-label="Open West End Chiropractic in Google Maps">
      <Picture src={map} alt="Map showing West End Chiropractic at 1611 W. 5th St. near MoPac" widths={[360, 520, 760, 1000]} sizes="(min-width: 1280px) 470px, (min-width: 768px) 40vw, 100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
    </a>
  </div>
</section>
<style is:global>
  .location { background: var(--gradient-navy); }
  .location__inner { display: grid; gap: 40px; align-items: start; }
  .location__info { display: flex; flex-direction: column; gap: 40px; }
  .location__title { display: flex; align-items: center; gap: 16px; font-weight: 500; }
  .location__title strong { font-weight: 700; }
  .location__mark { display: none; }
  .location__list { display: flex; flex-direction: column; gap: 24px; }
  .location__name { font-size: 20px; line-height: 26px; color: var(--sand-100); }
  .location__name strong { font-weight: 600; }
  .location__grid { list-style: none; padding: 0; display: grid; gap: 24px; }
  .contact-item { display: flex; gap: 16px; font-size: 16px; line-height: 1.8; font-weight: 500; color: var(--white); }
  .contact-item__label { font-weight: 600; line-height: 22px; margin: 9px 0 4px; }
  .contact-item a:hover { color: var(--orange-500); }
  .contact-item--parking { align-items: center; font-weight: 400; }
  .contact-item--parking strong { font-weight: 600; }
  .location__btn { align-self: flex-start; }
  .location__rule { border: 0; height: 1px; background: rgb(235 231 224 / 0.16); }
  .location__map { display: block; border-radius: var(--radius-xl); overflow: hidden; background: var(--white); }
  .location__map img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 470 / 451; transition: transform var(--dur) var(--ease); }
  .location__map:hover img { transform: scale(1.02); }
  @media (max-width: 767.98px) {
    .location__mark { display: block; flex: none; width: 20px; color: var(--blue-300); opacity: 0.4; }
    .hide-mobile-inline { display: none; }
    .location__map img { aspect-ratio: 342 / 340; }
  }
  @media (min-width: 768px) { .location__grid { grid-template-columns: auto auto; column-gap: 24px; } }
  @media (min-width: 1280px) { .location__inner { grid-template-columns: minmax(0, 658px) minmax(0, 470px); justify-content: space-between; gap: 72px; } }
</style>
