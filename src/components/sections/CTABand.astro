---
// "Section / CTA Band": photo background with navy gradient, title, two buttons, small note.
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import bg from '../../assets/images/shared/cta-adjustment.webp';
import { site } from '../../data/site';
interface Props { title?: string; text?: string; note?: string; image?: ImageMetadata; imageAlt?: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string; icon?: string; iconAfter?: string } }
const {
  title = 'Ready to figure out<br>what’s going on?',
  text = 'Book your first visit. A full exam, any necessary digital X-rays, and a real answer about what’s going on.',
  note = '1611 W. 5th St., just off MoPac. Free covered garage parking. Monday through Thursday.',
  image = bg,
  imageAlt = '',
  primary = { label: site.bookLabel, href: site.bookHref },
  secondary = { label: `Call ${site.phone}`, href: site.phoneHref, icon: 'phone' },
} = Astro.props;
---
<section class="cta-band on-dark">
  <Picture quality={85} src={image} alt={imageAlt} widths={[480, 800, 1200, 1600, 2200, 2880]} sizes="100vw" formats={['webp']} fallbackFormat="webp" class="cta-band__bg" loading="lazy" />
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2 class="h2 cta-band__title" set:html={title} />
      <p class="cta-band__text" set:html={text} />
    </div>
    <div class="cta-band__buttons">
      <Button href={primary.href} blockMobile>{primary.label}</Button>
      <Button href={secondary.href} variant="outline-light" icon={secondary.icon} iconAfter={secondary.iconAfter} blockMobile class="cta-band__call">{secondary.label}</Button>
    </div>
    {note && <p class="cta-band__note">{note}</p>}
  </div>
</section>
<style is:global>
  .cta-band { position: relative; overflow: hidden; background: var(--navy-900); isolation: isolate; }
  .cta-band__bg, .cta-band picture { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; }
  /* Figma: photo object-fit cover, centred */
  .cta-band__bg { object-fit: cover; object-position: 50% 50%; }
  /* Figma overlay: multiply navy gradient, then a normal-blend bottom fade */
  .cta-band::before, .cta-band::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .cta-band::before { background: linear-gradient(88.11deg, #0f2d40 0%, #1b4f72 49.52%, rgb(19 58 83 / 0.49) 72.12%, rgb(15 45 64 / 0.18) 100%); mix-blend-mode: multiply; }
  .cta-band::after { background: linear-gradient(180deg, rgb(15 45 64 / 0) 26.92%, rgb(15 45 64 / 0.11) 39.9%, rgb(15 45 64 / 0.32) 100%); }
  .cta-band__inner { display: flex; flex-direction: column; gap: 40px; padding-block: 80px; min-height: 615px; justify-content: center; }
  .cta-band__copy { display: flex; flex-direction: column; gap: 24px; max-width: 742px; }
  .cta-band__title { font-weight: 600; }
  .cta-band__text { color: var(--sand-100); max-width: 448px; }
  .cta-band__buttons { display: flex; flex-wrap: wrap; gap: 16px; }
  .cta-band__call .icon { color: var(--orange-500); }
  .cta-band__note { font-size: 14px; line-height: 1.8; color: var(--sand-100); opacity: 0.8; }
  @media (max-width: 767.98px) {
    /* Figma mobile frame (390 wide): photo 239.25% wide, shifted -119.61% left and -56px up */
    .cta-band picture { inset: 0; width: 100%; height: 100%; overflow: hidden; }
    .cta-band__bg { position: absolute; left: -119.61%; top: -14.36vw; width: 239.25%; max-width: none; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
    .cta-band::before { background: linear-gradient(0.6deg, #0f2d40 30.39%, #1b4f72 56.22%, rgb(19 58 83 / 0.49) 78.7%, rgb(15 45 64 / 0.18) 99.75%); }
    .cta-band::after { display: none; }
    /* below the photo Figma's multiply layer sits on nothing (= white), so the gradient shows as-is */
    .cta-band { background: #fff; }
    .cta-band__inner { padding-block: 60px; min-height: 808px; justify-content: flex-end; gap: 40px; }
    .cta-band__title { font-size: 32px; }
    .cta-band__buttons { flex-direction: column; }
  }
</style>
