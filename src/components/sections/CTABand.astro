---
// "Section / CTA Band": photo background with navy gradient, title, two buttons, small note.
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import bg from '../../assets/images/shared/cta-adjustment.webp';
import { site } from '../../data/site';
interface Props { title?: string; text?: string; note?: string; image?: ImageMetadata; imageAlt?: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string; icon?: string } }
const {
  title = 'Ready to figure out<br>what’s going on?',
  text = 'Book your first visit. A full exam, any necessary digital X-rays, and a real answer about what’s going on.',
  note = '1611 W. 5th St., just off MoPac. Free covered garage parking. Monday through Thursday.',
  image = bg,
  imageAlt = '',
  primary = { label: site.bookLabel, href: site.bookHref },
  secondary = { label: `Call ${site.phone}`, href: site.phoneHref, icon: 'phone' },
} = Astro.props;
---
<section class="cta-band on-dark">
  <Picture src={image} alt={imageAlt} widths={[480, 800, 1200, 1600, 2200, 2880]} sizes="100vw" formats={['webp']} fallbackFormat="webp" class="cta-band__bg" loading="lazy" />
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2 class="h2 cta-band__title" set:html={title} />
      <p class="cta-band__text" set:html={text} />
    </div>
    <div class="cta-band__buttons">
      <Button href={primary.href} blockMobile>{primary.label}</Button>
      <Button href={secondary.href} variant="outline-light" icon={secondary.icon} blockMobile class="cta-band__call">{secondary.label}</Button>
    </div>
    {note && <p class="cta-band__note">{note}</p>}
  </div>
</section>
<style is:global>
  .cta-band { position: relative; overflow: hidden; background: var(--navy-900); isolation: isolate; }
  .cta-band__bg, .cta-band picture { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; }
  .cta-band__bg { object-fit: cover; object-position: 70% 30%; }
  .cta-band::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, #0f2d40 0%, rgb(27 79 114 / 0.95) 38%, rgb(19 58 83 / 0.45) 62%, rgb(15 45 64 / 0.18) 100%), linear-gradient(180deg, rgb(15 45 64 / 0) 27%, rgb(15 45 64 / 0.1) 40%, rgb(15 45 64 / 0.32) 100%); }
  .cta-band__inner { display: flex; flex-direction: column; gap: 40px; padding-block: 80px; min-height: 615px; justify-content: center; }
  .cta-band__copy { display: flex; flex-direction: column; gap: 24px; max-width: 742px; }
  .cta-band__title { font-weight: 600; }
  .cta-band__text { color: var(--sand-100); max-width: 448px; }
  .cta-band__buttons { display: flex; flex-wrap: wrap; gap: 16px; }
  .cta-band__call .icon { color: var(--orange-500); }
  .cta-band__note { font-size: 14px; line-height: 1.8; color: var(--sand-100); opacity: 0.8; }
  @media (max-width: 767.98px) {
    .cta-band__bg { position: relative; height: 360px; object-position: 62% 20%; }
    .cta-band picture { position: absolute; height: 380px; inset: 0 0 auto 0; }
    .cta-band::before { background: linear-gradient(180deg, rgb(15 45 64 / 0.18) 0%, rgb(15 45 64 / 0.4) 140px, rgb(27 79 114 / 0.95) 300px, #0f2d40 100%); }
    .cta-band__inner { padding-top: 200px; padding-bottom: 60px; min-height: 0; gap: 32px; }
    .cta-band__buttons { flex-direction: column; }
  }
</style>
