---
import logo from '../../assets/logos/logo-wordmark.svg?raw';
interface Props { width?: number; class?: string }
const { width = 180, class: cls } = Astro.props;
const svg = logo.replace(/preserveAspectRatio="none" overflow="visible" style="display: block;"/, '')
  .replace(/width="180" height="40"/, `width="${width}" height="${Math.round(width * 40 / 180)}" role="img" aria-label="West End Chiropractic"`)
  .replace(/<g id="Logo 2">/, '<title>West End Chiropractic</title><g>');
---
<span class:list={['logo', cls]} set:html={svg} />
<style>.logo { display: inline-flex; line-height: 0; }</style>
