---
// Inline SVG icon from src/assets/icons (Lucide + custom WEC icons). Colour = currentColor.
const icons = import.meta.glob<string>('../../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
interface Props { name: string; size?: number; class?: string; label?: string; strokeWidth?: number }
const { name, size = 24, class: cls, label, strokeWidth } = Astro.props;
const raw = icons[`../../assets/icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found in src/assets/icons`);
let svg = raw
  .replace(/\swidth="[^"]*"/, ` width="${size}"`)
  .replace(/\sheight="[^"]*"/, ` height="${size}"`)
  .replace('<svg', `<svg class="icon${cls ? ' ' + cls : ''}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`);
if (strokeWidth) svg = svg.replace(/stroke-width="[^"]*"/, `stroke-width="${strokeWidth}"`);
---
<Fragment set:html={svg} />
