---
// Avatar stack + "5.0 stars, 250+ Google reviews"
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../../data/site';
const avatars = Object.values(import.meta.glob<{ default: ImageMetadata }>('../../assets/images/avatars/hero-*.webp', { eager: true })).map((m) => m.default);
interface Props { tone?: 'dark' | 'light'; layout?: 'stack' | 'row'; class?: string }
const { tone = 'dark', layout = 'stack', class: cls } = Astro.props;
---
<div class:list={['rating', `rating--${tone}`, `rating--${layout}`, cls]}>
  <span class="rating__avatars" aria-hidden="true">
    {avatars.map((a) => <Image quality={85} src={a} alt="" width={32} height={32} densities={[1, 2]} loading="lazy" />)}
  </span>
  <a class="rating__text" href={site.googleReviewsHref} target="_blank" rel="noopener"><Icon name="google" size={14} /><span>{site.reviews.rating} stars, {site.reviews.count} Google reviews</span></a>
</div>
<style is:global>
  .rating { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .rating--row { flex-direction: row; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px 16px; }
  .rating__avatars { display: flex; }
  .rating__avatars img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid var(--navy-900); background: var(--neutral-300); }
  .rating__avatars img + img { margin-left: -8px; }
  .rating--light .rating__avatars img { border-color: var(--sand-200); }
  .rating__text { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; line-height: 22px; font-weight: 500; color: var(--sand-100); }
  .rating--light .rating__text { color: var(--navy-900); }
  .rating__text:hover span { text-decoration: underline; text-underline-offset: 3px; }
</style>
