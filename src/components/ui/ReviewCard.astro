---
// "Card / Review". Avatars live in /public/avatars/NNN.jpg (downloaded by the installer from Google).
// If a photo is missing, the initials circle underneath shows instead.
import Icon from './Icon.astro';
interface Props { name: string; text: string; avatar?: string }
const { name, text, avatar } = Astro.props;
const initials = name.replace(/[^A-Za-z' ]/g, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('') || '★';
---
<article class="review">
  <div class="review__stars" role="img" aria-label="5 out of 5 stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</div>
  <blockquote class="review__text"><p>{text}</p></blockquote>
  <footer class="review__who">
    <span class="review__avatar" aria-hidden="true">
      <span>{initials}</span>
      {avatar && <img src={`/avatars/${avatar}.jpg`} alt="" width="40" height="40" loading="lazy" decoding="async" onerror="this.remove()" />}
    </span>
    <span class="review__meta"><cite class="review__name">{name}</cite><span class="review__src"><Icon name="google" size={12} />Google Review</span></span>
  </footer>
</article>
<style is:global>
  .review { display: flex; flex-direction: column; gap: 16px; padding: 24px; background: var(--white); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-soft); break-inside: avoid; }
  .review__stars { display: flex; gap: 2px; color: var(--orange-500); }
  .review__stars .icon { fill: currentColor; }
  .review__text { font-size: 16px; line-height: 1.8; color: var(--navy-900); }
  .review__who { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid rgb(15 45 64 / 0.06); }
  .review__avatar { position: relative; flex: none; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: var(--sand-200); color: var(--navy-700); font-size: 14px; font-weight: 600; }
  .review__avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .review__meta { display: flex; flex-direction: column; gap: 2px; }
  .review__name { font-style: normal; font-size: 16px; line-height: 22px; font-weight: 600; color: var(--navy-900); }
  .review__src { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; line-height: 16px; color: var(--navy-600); }
</style>
