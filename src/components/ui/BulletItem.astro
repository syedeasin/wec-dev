---
// "List / Bullet Item": icon + short text, vertically centred.
import Icon from './Icon.astro';
interface Props { icon?: string; size?: 14 | 16 | 20 | 24; class?: string; iconClass?: string }
const { icon = 'check', size = 20, class: cls, iconClass } = Astro.props;
---
<li class:list={['bullet', `bullet--${size}`, cls]}><Icon name={icon} size={size} class={iconClass ?? 'bullet__icon'} /><span><slot /></span></li>
<style is:global>
  .bullet { display: flex; align-items: flex-start; gap: 8px; }
  .bullet .icon { flex: none; margin-top: calc((1lh - var(--bsz)) / 2); }
  .bullet--14 { --bsz: 14px; } .bullet--16 { --bsz: 16px; } .bullet--20 { --bsz: 20px; } .bullet--24 { --bsz: 24px; }
  .bullet-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
</style>
