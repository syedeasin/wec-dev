---
// Decorative "vine" shape from Figma (Vector 441×1304). Purely visual, hidden from AT.
// Position it with the `style` prop (top/left/right/rotate) inside a position:relative section.
//
// Optional Figma-exact mode:
//  - fillOpacity: applies opacity per path (like Figma's fill-opacity), so overlapping
//    bones stack and read a little stronger than a single group opacity would.
//  - rotate + box: Figma exports rotated vectors as a bounding box (box = [w, h]) with the
//    shape rotated around its centre. Pass both to reproduce that exactly.
import raw from '../../assets/deco/vine.svg?raw';
interface Props { class?: string; style?: string; opacity?: number; fillOpacity?: number; color?: string; width?: number; rotate?: number; box?: [number, number] }
const { class: cls, style = '', opacity = 0.04, fillOpacity, color = '#fff', width = 441, rotate, box } = Astro.props;
let svg = raw.replace('<svg', `<svg width="${width}" height="${Math.round(width * 1304 / 441)}" aria-hidden="true" focusable="false"${rotate != null ? ` style="transform:rotate(${rotate}deg);flex:none"` : ''}`);
if (fillOpacity != null) svg = svg.replaceAll('fill="currentColor"', `fill="currentColor" fill-opacity="${fillOpacity}"`);
const groupOpacity = fillOpacity != null ? 1 : opacity;
const boxStyle = box ? `width:${box[0]}px;height:${box[1]}px;display:flex;align-items:center;justify-content:center;` : '';
---
<span class:list={['deco', cls]} style={`color:${color};opacity:${groupOpacity};${boxStyle}${style}`} set:html={svg} />
<style is:global>
  .deco { position: absolute; pointer-events: none; z-index: 0; line-height: 0; }
  .deco svg { display: block; max-width: none; }
</style>
