---
// "Work downtown? You're probably covered": copy left, employer → plan card right.
import Title from './Title.astro';
import Buttons from './Buttons.astro';
import Rich from './Rich.astro';
import { strip, textLink, type Section, type Para } from '../../lib/content';
interface Props { s: Section; bg?: 'white' | 'sand' }
const { s, bg = 'white' } = Astro.props;
const paras = s.paras ?? [];
const intro = paras[0];
type Emp = { name: string; sub: string[]; chips: string[] };
const emps: Emp[] = [];
const notes: Para[] = [];
const foot: string[] = [];
let link: { label: string; href: string } | undefined;
for (const p of paras.slice(1)) {
  const t = strip(p.t);
  if (textLink(p.t)) { link = textLink(p.t); continue; }
  if (t === 'Employer plans vary' || t === 'We confirm yours when we verify') { foot.push(t); continue; }
  if (p.w === 600 && (t === 'In-network' || t === 'No referral')) { emps.at(-1)?.chips.push(t); continue; }
  if (p.w === 600 && t.length < 40) { emps.push({ name: p.t, sub: [], chips: [] }); continue; }
  if (p.w === 400 && t.length < 60 && emps.length && !foot.length) { emps.at(-1)!.sub.push(p.t); continue; }
  notes.push(p);
}
const [featured, ...others] = emps;
---
<section class:list={['section emp', `section--${bg}`]}>
  <div class="container emp__grid">
    <div class="emp__copy">
      <Title title={s.title} mark={false} />
      {intro && <p set:html={intro.t} />}
      <Rich paras={notes} class="emp__notes" />
      <div class="emp__actions">
        <Buttons buttons={s.buttons} />
        {link && <a class="text-link" href={link.href}>{link.label.replace(/\s*[→↗]$/, '')} →</a>}
      </div>
    </div>
    <div class="emp__card">
      {featured && (
        <div class="emp__featured">
          <p class="emp__name" set:html={featured.name} />
          {featured.sub.map((x, i) => <p class:list={[i === 0 ? 'emp__meta' : 'emp__plan']} set:html={x} />)}
          {featured.chips.length > 0 && <p class="emp__chips">{featured.chips.map((c) => <span>{c}</span>)}</p>}
        </div>
      )}
      <ul class="emp__list" role="list">
        {others.map((e) => <li><span class="emp__name" set:html={e.name} /><span class="emp__plan" set:html={e.sub.join(' · ')} /></li>)}
      </ul>
      {foot.length > 0 && <p class="emp__foot">{foot.join(' · ')}</p>}
    </div>
  </div>
</section>
<style is:global>
  .emp__grid { display: grid; gap: 40px; align-items: center; }
  .emp__copy { display: flex; flex-direction: column; gap: 24px; }
  .emp__notes { color: var(--navy-600); }
  .emp__actions { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .emp__card { padding: 12px; background: var(--sand-100); border-radius: var(--radius-xl); display: flex; flex-direction: column; gap: 8px; }
  .emp__featured { display: flex; flex-direction: column; gap: 4px; padding: 20px 24px; background: var(--white); border: 1px solid var(--orange-500); border-radius: var(--radius-lg); }
  .emp__name { font-weight: 600; color: var(--navy-900); }
  .emp__meta { font-size: 12px; line-height: 18px; color: var(--navy-600); padding-bottom: 12px; border-bottom: 1px solid var(--border-light); margin-bottom: 8px; }
  .emp__plan { font-size: 12px; line-height: 18px; color: var(--navy-600); }
  .emp__plan strong { color: var(--navy-900); font-weight: 700; }
  .emp__chips { display: flex; gap: 0; margin-top: 8px; }
  .emp__chips span { display: inline-flex; align-items: center; min-height: 24px; padding: 4px 10px; background: var(--sand-100); color: var(--navy-600); font-size: 10px; line-height: 1; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .emp__chips span:first-child { border-radius: var(--radius-full) 0 0 var(--radius-full); }
  .emp__chips span:last-child { border-radius: 0 var(--radius-full) var(--radius-full) 0; border-left: 1px solid var(--border-light); }
  .emp__list { list-style: none; padding: 8px 24px; margin: 0; background: var(--white); border-radius: var(--radius-lg); }
  .emp__list li { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding-block: 16px; border-bottom: 1px solid var(--border-light); }
  .emp__list li:last-child { border-bottom: 0; }
  .emp__list .emp__plan { text-align: right; }
  .emp__foot { padding: 8px 24px 12px; font-size: 12px; line-height: 18px; color: var(--navy-600); }
  @media (min-width: 1024px) { .emp__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; } }
  @media (max-width: 767.98px) { .emp { padding-block: 60px; } .emp__list { padding: 4px 16px; } .emp__featured { padding: 16px; } .emp__actions { flex-direction: column; align-items: stretch; } }
</style>
