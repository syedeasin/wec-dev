---
// Renders grouped paragraphs: paragraphs, check lists and title+text items.
import Icon from '../ui/Icon.astro';
import { groupParas, isUpper, textLink, type Para } from '../../lib/content';
interface Props { paras?: Para[]; class?: string; dark?: boolean }
const { paras = [], class: cls } = Astro.props;
const blocks = groupParas(paras);
---
<div class:list={['rich', cls]}>
  {blocks.map((b) =>
    b.kind === 'list' ? (
      <ul class="rich__list" role="list">{b.items.map((t) => <li><span class="rich__check"><Icon name="check" size={16} /></span><span set:html={t} /></li>)}</ul>
    ) : b.kind === 'def' ? (
      <div class="rich__def"><p class="rich__dt" set:html={b.title} />{b.text.map((t) => <p set:html={t} />)}</div>
    ) : textLink(b.t) ? (
      <p><a class="text-link" href={textLink(b.t)!.href} target={textLink(b.t)!.href.startsWith('http') ? '_blank' : undefined} rel={textLink(b.t)!.href.startsWith('http') ? 'noopener' : undefined}><Fragment set:html={textLink(b.t)!.label.replace(/\s*[→↗]$/, '')} /><Icon name="arrow-up-right" size={16} /></a></p>
    ) : isUpper(b.t) && b.w >= 700 ? (
      <p class="eyebrow rich__eyebrow" set:html={b.t} />
    ) : (
      <p class:list={[`fw-${Math.min(b.w, 600)}`]} set:html={b.t} />
    )
  )}
</div>
<style is:global>
  .rich { display: flex; flex-direction: column; gap: 16px; }
  .rich strong { font-weight: 600; }
  .rich__eyebrow { color: var(--orange-500); }
  .rich__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; font-weight: 600; }
  .rich__list li { display: flex; gap: 12px; align-items: flex-start; }
  .rich__check { flex: none; display: grid; place-items: center; width: 24px; height: 24px; margin-top: 2px; border-radius: 50%; background: rgb(232 81 42 / 0.12); color: var(--orange-500); }
  .rich__def { display: flex; flex-direction: column; gap: 4px; padding-left: 16px; border-left: 2px solid var(--blue-300); }
  .rich__dt { font-weight: 600; color: var(--navy-900); }
  .on-dark .rich__dt { color: var(--white); }
</style>
