---
// Rounded photo from the page data. `pos` keeps the Figma crop focus, `flip` mirrors it.
import { Picture } from 'astro:assets';
import { img, altFor, type Img } from '../../lib/content';
interface Props { image: Img; alt?: string; sizes?: string; class?: string; ratio?: string; eager?: boolean; shadow?: boolean }
const { image, alt, sizes = '(min-width: 1280px) 560px, (min-width: 1024px) 45vw, 100vw', class: cls, ratio, eager = false, shadow = true } = Astro.props;
const meta = img(image.src);
const style = [image.pos && `--pos:${image.pos}`, ratio && `--ratio:${ratio}`, image.flip && '--flip:-1'].filter(Boolean).join(';');
const widths = [360, 540, 720, 960, 1200, 1600, 2000, 2400].filter((w) => w <= meta.width);
if (!widths.includes(meta.width)) widths.push(meta.width); // always offer the full-size original
---
<div class:list={['media', shadow && 'media--shadow', cls]} style={style}>
  <Picture quality={85} src={meta} alt={alt ?? altFor(image.src)} widths={widths} sizes={sizes} formats={['webp']} fallbackFormat="webp" loading={eager ? 'eager' : 'lazy'} />
</div>
<style is:global>
  .media { position: relative; border-radius: var(--radius-xl); overflow: hidden; background: var(--sand-200); }
  .media--shadow { box-shadow: var(--shadow-image); }
  .media picture, .media img { display: block; width: 100%; height: 100%; }
  .media img { object-fit: cover; object-position: var(--pos, 50% 50%); aspect-ratio: var(--ratio, auto); transform: scaleX(var(--flip, 1)); }
</style>
