---
// New patient / personal injury forms: intake form card + embed, directions, location.
import SiteLayout from '../../layouts/SiteLayout.astro';
import CompactHero from './CompactHero.astro';
import Callout from './Callout.astro';
import Button from '../ui/Button.astro';
import IconTile from '../ui/IconTile.astro';
import Icon from '../ui/Icon.astro';
import Location from '../sections/Location.astro';
import { site } from '../../data/site';
import { icon, strip, type PageData } from '../../lib/content';
interface Props { data: PageData; title: string; description: string; url: string; pdf: string }
const { data, title, description, url, pdf } = Astro.props;
const [hero, body, loc] = data.sections;
const crumb = strip(hero.paras?.[0]?.t ?? '').split('/').pop()!.trim();
const form = body.cards?.[0];
const fill = url || '#intake-form';
---
<SiteLayout title={title} description={description}>
  <CompactHero title={hero.title ?? ''} crumb={crumb} sub={hero.paras?.[1]?.t}>
    <div class="btn-row chero__btns">
      <Button href={fill} blockMobile icon="file-pen-line">Fill Out the Form</Button>
      <Button href={site.bookHref} variant="outline-light" blockMobile>Existing Patients</Button>
    </div>
  </CompactHero>
  <section class="section section--white forms">
    <div class="container forms__grid">
      <div class="forms__main">
        <h2 class="h2" set:html={body.title ?? ''} />
        {body.callouts?.map((c) => <Callout title={c.title}><p><a class="text-link" href="/forms">Self pay forms →</a></p></Callout>)}
        {form && (
          <div class="forms__card">
            <IconTile name={icon(form.icon)} tone="orange" />
            <div class="forms__card-body"><h3 class="h4">{form.title}</h3><p class="a1 text-muted">{form.text}</p></div>
            <div class="btn-row">
              <Button href={fill} blockMobile>Fill Out the Form</Button>
              {pdf && <Button href={pdf} variant="secondary" icon="download" blockMobile download>Download PDF</Button>}
            </div>
          </div>
        )}
        <div class="forms__embed" id="intake-form">
          {url ? <iframe src={url} title={form?.title ?? 'Intake form'} loading="lazy"></iframe> : (
            <div class="forms__placeholder"><Icon name="clipboard-list" size={32} /><p><strong>The online intake form is on its way.</strong><br />Until then, call <a href={site.phoneHref}>{site.phone}</a> and we’ll send it to you.</p></div>
          )}
        </div>
      </div>
      <aside class="forms__aside">
        <h3 class="h4" set:html={body.paras?.[0]?.t ?? ''} />
        <ol class="num-list" role="list">
          {body.steps?.map((st, i) => <li><span class="num-list__n">{i + 1}</span><p class="a1" set:html={st.title} /></li>)}
          <li><span class="num-list__n">{(body.steps?.length ?? 0) + 1}</span><p class="a1" set:html={body.paras?.[1]?.t ?? ''} /></li>
        </ol>
        <p class="fw-600">See you soon!</p>
      </aside>
    </div>
  </section>
  {loc && <Location title={loc.title} />}
</SiteLayout>
<style is:global>
  .chero__btns { margin-top: 16px; }
  .forms__grid { display: grid; gap: 40px; align-items: start; }
  .forms__main { display: flex; flex-direction: column; gap: 32px; }
  .forms__card { display: flex; flex-direction: column; gap: 20px; padding: 32px; border-radius: var(--radius-xl); background: var(--sand-100); }
  .forms__card-body { display: flex; flex-direction: column; gap: 8px; }
  .forms__embed iframe { width: 100%; min-height: 900px; border: 1px solid var(--border-light); border-radius: var(--radius-xl); }
  .forms__placeholder { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 48px 24px; text-align: center; border: 2px dashed var(--border-light); border-radius: var(--radius-xl); color: var(--navy-600); }
  .forms__placeholder a { color: var(--orange-500); font-weight: 600; }
  .forms__aside { display: flex; flex-direction: column; gap: 24px; padding: 32px; border-radius: var(--radius-xl); border: 1px solid var(--border-light); }
  @media (min-width: 1024px) { .forms__grid { grid-template-columns: minmax(0, 1fr) 380px; gap: 80px; } .forms__aside { position: sticky; top: 24px; } }
  @media (max-width: 767.98px) { .forms { padding-block: 48px; } .forms__card, .forms__aside { padding: 24px 16px; } }
</style>
