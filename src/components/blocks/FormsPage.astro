---
// New patient / personal injury forms: intake form card + embed, directions, location.
import SiteLayout from '../../layouts/SiteLayout.astro';
import CompactHero from './CompactHero.astro';
import Callout from './Callout.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Location from '../sections/Location.astro';
import { site } from '../../data/site';
import { icon, strip, type PageData } from '../../lib/content';
interface Props { data: PageData; title: string; description: string; url: string; pdf: string }
const { data, title, description, url, pdf } = Astro.props;
const [hero, body, loc] = data.sections;
const crumb = strip(hero.paras?.[0]?.t ?? '').split('/').pop()!.trim();
const form = body.cards?.[0];
const fill = url || '#intake-form';
const image = 'photos/office-sign-hero';
// Figma order: location, parking, entrance.
const dirs = [body.steps?.[0]?.title, body.paras?.[1]?.t, body.steps?.[1]?.title].filter(Boolean) as string[];
---
<SiteLayout title={title} description={description}>
  <CompactHero title={hero.title ?? ''} crumb={crumb} sub={hero.paras?.[1]?.t} image={image}>
    <div class="btn-row chero__btns">
      <Button href={fill} blockMobile class="forms__hero-fill">Fill Out the Form</Button>
      <Button href={site.bookHref} variant="outline-light" icon="arrow-up-right" blockMobile>Existing Patients</Button>
    </div>
  </CompactHero>
  <section class="section section--white forms">
    <div class="container forms__body">
      <div class="forms__main">
        <h2 class="forms__h" set:html={body.title ?? ''} />
        {body.callouts?.map((c) => <Callout title={c.title}><p><a class="text-link" href="/forms">Self pay forms →</a></p></Callout>)}
        {form && (
          <div class="forms__card">
            <div class="forms__card-head">
              <span class="forms__tile"><Icon name={icon(form.icon)} size={24} /></span>
              <div class="forms__card-body"><h3 class="forms__card-title">{form.title}</h3><p>{form.text}</p></div>
            </div>
            <div class="forms__embed" id="intake-form">
              {url ? <iframe src={url} title={form?.title ?? 'Intake form'} loading="lazy"></iframe> : (
                <div class="forms__placeholder"><Icon name="clipboard-list" size={32} /><p class="forms__ph-title">The online intake form is on its way.</p><p class="forms__ph-text">Until then, call <a href={site.phoneHref}>{site.phone}</a> and we’ll send it to you.</p></div>
              )}
            </div>
            <div class="btn-row">
              <Button href={fill} blockMobile>Fill Out the Form</Button>
              {pdf && <Button href={pdf} variant="secondary" icon="download" blockMobile download>Download PDF</Button>}
            </div>
          </div>
        )}
      </div>
      <hr class="forms__rule" />
      <div class="forms__dir">
        <h2 class="forms__h" set:html={body.paras?.[0]?.t ?? ''} />
        <ol class="forms__list" role="list">
          {dirs.map((t, i) => <li><span class="forms__n">{i + 1}</span><p set:html={t} /></li>)}
        </ol>
        <p class="forms__soon">See you soon!</p>
      </div>
    </div>
  </section>
  {loc && <Location title={loc.title} />}
</SiteLayout>
<style is:global>
  .chero__btns { margin-top: 16px; }
  .forms__hero-fill { min-width: 231px; }
  .forms { padding: 100px 0 120px; }
  .forms__body { max-width: 860px; display: flex; flex-direction: column; gap: 48px; }
  .forms__main { display: flex; flex-direction: column; gap: 24px; }
  .forms__h { font-size: 32px; line-height: 1.2; font-weight: 600; color: var(--navy-900); }
  .forms__card { display: flex; flex-direction: column; gap: 24px; padding: 32px; border-radius: 16px; background: var(--sand-100); }
  .forms__card-head { display: flex; align-items: center; gap: 20px; }
  .forms__tile { flex: none; width: 56px; height: 56px; border-radius: 12px; background: #fff; display: grid; place-items: center; color: var(--orange-500); }
  .forms__card-body { display: flex; flex-direction: column; gap: 6px; }
  .forms__card-title { font-size: 24px; line-height: 36px; font-weight: 600; color: var(--navy-900); }
  .forms__card-body p { font-size: 16px; line-height: 1.8; color: var(--navy-600); }
  .forms__embed iframe { display: block; width: 100%; min-height: 900px; border: 0; border-radius: 12px; background: #fff; }
  .forms__placeholder { height: 400px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 0 24px; text-align: center; background: #fff; border: 1.5px dashed var(--navy-900); border-radius: 12px; color: var(--navy-900); }
  .forms__placeholder svg { margin-bottom: 0; }
  .forms__ph-title { font-size: 16px; line-height: 1.8; font-weight: 600; }
  .forms__ph-text { font-size: 14px; line-height: 22px; color: var(--navy-600); }
  .forms__placeholder a { color: var(--orange-500); font-weight: 600; }
  .forms__rule { border: 0; height: 1px; background: #e3e3e3; margin: 0; }
  .forms__dir { display: flex; flex-direction: column; gap: 20px; }
  .forms__list { display: flex; flex-direction: column; gap: 10px; list-style: none; padding: 0; margin: 0; }
  .forms__list li { display: flex; gap: 14px; align-items: flex-start; }
  .forms__n { flex: none; width: 26px; height: 26px; border-radius: 6px; background: var(--orange-500); color: #fff; font-size: 12px; line-height: 22px; font-weight: 700; display: grid; place-items: center; }
  .forms__list p { font-size: 16px; line-height: 1.8; color: var(--navy-600); }
  .forms__soon { font-size: 16px; line-height: 1.8; font-weight: 600; color: var(--navy-900); }
  @media (max-width: 767.98px) {
    .forms { padding: 64px 0 80px; }
    .forms__body { gap: 40px; }
    .forms__h { font-size: 24px; }
    .forms__card { padding: 20px 16px; }
    .forms__card-head { align-items: flex-start; gap: 16px; }
    .forms__tile { width: 48px; height: 48px; }
    .forms__card-title { font-size: 20px; line-height: 30px; }
    .forms__card-body p { font-size: 14px; line-height: 22px; }
    .forms__placeholder { height: 280px; }
  }
</style>
