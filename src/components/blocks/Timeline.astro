---
// "How long until this feels better": copy left, orange card with tagged stages right.
import Title from './Title.astro';
import Rich from './Rich.astro';
import Buttons from './Buttons.astro';
import type { Section } from '../../lib/content';
interface Props { s: Section; bg?: 'white' | 'sand' }
const { s, bg = 'white' } = Astro.props;
---
<section class:list={['section timeline', `section--${bg}`]}>
  <div class:list={['container timeline__grid', !s.paras?.length && 'timeline__grid--solo']}>
    <div class="timeline__copy">
      <Title title={s.title} />
      <Rich paras={s.paras} />
      <Buttons buttons={s.buttons} />
    </div>
    <ol class="timeline__card" role="list">
      {s.tags?.map((t) => (
        <li class="timeline__item">
          <span class="timeline__tag">{t.tag}</span>
          <p set:html={t.text} />
        </li>
      ))}
    </ol>
  </div>
</section>
<style is:global>
  .timeline__grid { display: grid; gap: 40px; align-items: center; }
  .timeline__copy { display: flex; flex-direction: column; gap: 24px; }
  .timeline__card { list-style: none; margin: 0; padding: 24px; display: flex; flex-direction: column; gap: 16px; border-radius: var(--radius-xl); background: var(--gradient-primary); box-shadow: var(--shadow-btn-lg); }
  .timeline__item { display: flex; flex-direction: column; gap: 12px; padding: 24px; background: var(--white); border-radius: var(--radius-lg); font-size: var(--fs-a1); line-height: var(--lh-a1); color: var(--navy-600); }
  .timeline__tag { align-self: flex-start; display: inline-flex; align-items: center; min-height: 28px; padding: 4px 12px; border-radius: var(--radius-full); background: rgb(232 81 42 / 0.12); color: var(--orange-500); font-size: 12px; line-height: 1; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .timeline__grid--solo .timeline__card { display: grid; }
  @media (min-width: 1024px) {
    .timeline__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; }
    .timeline__grid--solo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); }
    .timeline__card { padding: 32px; }
  }
  @media (max-width: 767.98px) { .timeline { padding-block: 60px; } .timeline__card { padding: 12px; } .timeline__item { padding: 20px 16px; } }
</style>
