---
// "How long until this feels better": copy left, orange card with tagged stages right.
import Title from './Title.astro';
import Rich from './Rich.astro';
import Buttons from './Buttons.astro';
import Callout from './Callout.astro';
import type { Section } from '../../lib/content';
interface Props { s: Section; bg?: 'white' | 'sand' }
const { s, bg = 'white' } = Astro.props;
// Figma: the closing "If you are only trying…" paragraph is a Callout, not body copy
const paras = s.paras ?? [];
const last = paras.length >= 3 && /^If you are only/i.test(paras[paras.length - 1].t) ? paras[paras.length - 1] : undefined;
const body = last ? paras.slice(0, -1) : paras;
---
<section class:list={['section timeline', `section--${bg}`]}>
  <div class:list={['container timeline__grid', !s.paras?.length && 'timeline__grid--solo']}>
    <div class="timeline__copy">
      <div class="timeline__head">
        <Title title={s.title} />
        <Rich paras={body} />
      </div>
      {last && <Callout text={last.t} />}
      <Buttons buttons={s.buttons} />
    </div>
    <ol class="timeline__card" role="list">
      {s.tags?.map((t) => (
        <li class="timeline__item">
          <span class="timeline__tag">{t.tag}</span>
          <p set:html={t.text} />
        </li>
      ))}
    </ol>
  </div>
</section>
<style is:global>
  .timeline__grid { display: grid; gap: 40px; align-items: center; }
  .timeline__copy { display: flex; flex-direction: column; gap: 32px; }
  .timeline__head { display: flex; flex-direction: column; gap: 24px; }
  .timeline__head .rich { font-size: 16px; line-height: 1.8; font-weight: 500; color: var(--navy-900); }
  .timeline__card { list-style: none; margin: 0; padding: 32px; display: flex; flex-direction: column; gap: 13px; border-radius: var(--radius-xl); background: var(--orange-500); }
  .timeline__item { display: flex; flex-direction: column; gap: 16px; padding: 24px; background: var(--white); border-radius: var(--radius-md); box-shadow: 0 8px 32px rgb(15 45 64 / 0.08); font-size: 16px; line-height: 1.8; font-weight: 500; color: var(--navy-900); }
  .timeline__tag { align-self: flex-start; display: inline-flex; align-items: center; padding: 6px 12px; border-radius: var(--radius-md); background: rgb(232 81 42 / 0.08); color: var(--orange-500); font-size: 12px; line-height: 22px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
  .timeline__grid--solo .timeline__card { display: grid; }
  @media (min-width: 1024px) {
    .timeline__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 519px); gap: 124px; }
    .timeline__copy { padding-block: 24px; }
    .timeline__grid--solo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); }
  }
  @media (min-width: 1024px) and (max-width: 1279.98px) { .timeline__grid { gap: 60px; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); } }
  @media (max-width: 767.98px) { .timeline { padding-block: 60px; } .timeline__card { padding: 12px; } .timeline__item { padding: 20px 16px; font-size: 14px; } .timeline__head .rich { font-size: 14px; } }
</style>
