---
// "Find it, fix it, keep it from coming back": sand section, white card with 3 items + photo.
import Tag from '../ui/Tag.astro';
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import Buttons from './Buttons.astro';
import Media from './Media.astro';
import { icon, type Section } from '../../lib/content';
interface Props { s: Section }
const { s } = Astro.props;
const items = (s.bullets?.length ? s.bullets.map((b) => ({ icon: b.icon, title: b.text, text: b.body ?? '' })) : (s.cards ?? []).map((c) => ({ icon: c.icon, title: c.title, text: c.text ?? '' })));
const imgs = s.images ?? [];
const intro = s.paras?.[0]?.t;
---
<section class="section section--sand ffk">
  <div class="container ffk__inner">
    <div class="ffk__head">
      {s.tag && <Tag variant="orange">{s.tag}</Tag>}
      <SectionHead title={s.title ?? ''} maxWidth={1200} />
    </div>
    <div class="ffk__card">
      <ul class="ffk__list" role="list">
        {items.map((it, i) => (
          <li class="ffk__item">
            <div class="ffk__row">
              <span class="ffk__icon"><Icon name={icon(it.icon)} size={24} /></span>
              <div class="ffk__body"><h3 class="ffk__title" set:html={it.title} /><p class="ffk__text" set:html={it.text} /></div>
            </div>
            {imgs[i] && <Media image={imgs[i]} class="ffk__img-m" sizes="100vw" shadow={false} />}
          </li>
        ))}
      </ul>
      {imgs[0] && <Media image={imgs[0]} class="ffk__img-d" sizes="(min-width: 1280px) 900px, 70vw" />}
    </div>
    {intro && <p class="ffk__intro" set:html={intro} />}
    <Buttons buttons={s.buttons} center />
  </div>
</section>
<style is:global>
  .ffk__intro { max-width: 1020px; text-align: center; font-size: 16px; line-height: 1.8; color: var(--navy-900); opacity: 0.8; }
  .ffk__inner { display: flex; flex-direction: column; align-items: center; gap: 48px; }
  .ffk__head { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .ffk__card { width: 100%; display: grid; gap: 40px; padding: 40px; background: var(--white); border-radius: var(--radius-xl); box-shadow: var(--shadow-panel); align-items: stretch; }
  .ffk__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .ffk__item { display: flex; flex-direction: column; gap: 16px; padding: 24px; border: 1px solid var(--border-light); border-radius: var(--radius-lg); }
  .ffk__row { display: flex; gap: 16px; align-items: flex-start; }
  .ffk__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: rgb(232 81 42 / 0.1); color: var(--orange-500); }
  .ffk__body { display: flex; flex-direction: column; gap: 8px; }
  .ffk__title { font-size: var(--fs-p1); line-height: var(--lh-p1); font-weight: 600; }
  .ffk__text { font-size: var(--fs-a1); line-height: var(--lh-a1); color: var(--navy-600); }
  .ffk__img-m img { aspect-ratio: 342 / 234; }
  .ffk__img-d { display: none; }
  .ffk__img-d { min-height: 420px; }
  .ffk__img-d picture { position: absolute; inset: 0; }
  .ffk__img-d img { position: absolute; inset: 0; height: 100%; width: 100%; }
  @media (min-width: 1024px) {
    .ffk { padding-block: 100px; }
    .ffk__inner { gap: 40px; }
    .ffk__head { margin-bottom: 20px; }
    .ffk__head { gap: 24px; }
    .ffk__head .section-head h2, .ffk__head h2 { font-weight: 700; }
    .ffk__card { display: flex; gap: 0; padding: 0; overflow: hidden; border-radius: 16px; box-shadow: 0 32px 32px rgb(15 45 64 / 0.06); }
    .ffk__list { flex: 0 0 426px; gap: 0; }
    .ffk__item { position: relative; flex: 1 1 auto; justify-content: center; padding: 40px 32px; border: 0; border-radius: 0; border-top: 2px solid var(--sand, #f3f1ec); border-bottom: 2px solid var(--sand, #f3f1ec); border-right: 4px solid var(--sand, #f3f1ec); }
    .ffk__item:first-child { border-top: 0; }
    .ffk__item:last-child { border-bottom: 0; }
    .ffk__item:first-child::after { content: ''; position: absolute; left: -3px; bottom: -3px; width: 81px; height: 4px; border-radius: 2px; background: #72a6c8; }
    .ffk__row { display: block; }
    .ffk__icon { display: inline-grid; width: 24px; height: 24px; background: none; border-radius: 0; color: var(--orange-500); vertical-align: top; margin-right: 8px; float: left; }
    .ffk__body { gap: 16px; }
    .ffk__title { font-size: 20px; line-height: 26px; font-weight: 600; color: var(--navy-900); }
    .ffk__text { font-size: 16px; line-height: 1.8; color: var(--navy-900); clear: left; }
    .ffk__img-m { display: none; }
    .ffk__img-d { display: block; position: relative; flex: 1 1 0; min-width: 0; border-radius: 0; }
    .ffk__img-d img { border-radius: 0; object-fit: cover; }
    .ffk .btn { min-width: 300px; }
  }
  @media (max-width: 767.98px) {
    .ffk { padding-block: 60px; }
    .ffk__inner { gap: 32px; align-items: stretch; }
    .ffk__head { align-items: flex-start; }
    .ffk__head .section-head--center { align-items: flex-start; text-align: left; }
    .ffk__intro { text-align: left; font-size: 14px; }
    .ffk__card { padding: 12px; }
    .ffk__item { padding: 16px; }
    .ffk__icon { width: 40px; height: 40px; }
  }
</style>
