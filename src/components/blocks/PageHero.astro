---
// Inner-page hero: photo background with navy fade (desktop), photo under the copy (mobile).
import { Picture } from 'astro:assets';
import RatingRow from '../ui/RatingRow.astro';
import BulletItem from '../ui/BulletItem.astro';
import Buttons from './Buttons.astro';
import { img, icon, type Section } from '../../lib/content';
interface Props { s: Section; rating?: boolean }
const { s, rating = true } = Astro.props;
const [lead, ...rest] = s.paras ?? [];
// Auto spokes keep their trust items as short paragraphs; other pages use bullets.
const trust = s.bullets?.length ? s.bullets.map((b) => ({ icon: icon(b.icon), text: b.text }))
  : rest.filter((p) => p.t.length < 60).map((p, i) => ({ icon: ['shield-check', 'trust-x-ray', 'trust-calendar'][i] ?? 'check', text: p.t }));
const image = s.images?.[0];
const meta = image ? img(image.src) : undefined;
const pos = image?.pos ?? '70% 50%';
---
<section class="phero on-dark" style={`--pos:${pos}`}>
  {meta && <Picture src={meta} alt="" widths={[480, 768, 1280, 1920, 2560].filter((w) => w <= meta.width)} sizes="100vw" formats={['webp']} fallbackFormat="webp" class="phero__bg" loading="eager" fetchpriority="high" />}
  <div class="container phero__inner">
    <div class="phero__copy">
      {rating && <RatingRow layout="row" class="phero__rating" />}
      <div class="phero__title">
        <h1 class="h1" set:html={(s.title ?? '').replace(/\n/g, ' ')} />
        {lead && <p class="phero__lead" set:html={lead.t} />}
      </div>
      <Buttons buttons={s.buttons} dark class="phero__buttons" />
      {trust.length > 0 && (
        <ul class="phero__bullets" role="list">
          {trust.map((b) => <BulletItem icon={b.icon} size={20}>{b.text}</BulletItem>)}
        </ul>
      )}
    </div>
  </div>
  <div class="phero__media-mobile" aria-hidden="true"></div>
</section>
<style is:global>
  .phero { position: relative; isolation: isolate; overflow: hidden; background: var(--navy-900); }
  .phero > picture { position: absolute; inset: 0; z-index: -2; }
  .phero__bg { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  .phero::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, #0f2d40 0%, rgb(15 45 64 / 0.9) 30%, rgb(15 45 64 / 0.35) 58%, rgb(15 45 64 / 0.05) 80%), linear-gradient(180deg, rgb(15 45 64 / 0.5) 0%, rgb(15 45 64 / 0) 30%, rgb(15 45 64 / 0) 70%, rgb(15 45 64 / 0.6) 100%); }
  .phero__inner { padding-top: calc(var(--masthead-h) + 80px); padding-bottom: 100px; min-height: 760px; display: flex; align-items: center; }
  .phero__copy { display: flex; flex-direction: column; gap: 32px; max-width: 680px; }
  .phero__copy > .rating { justify-content: flex-start; align-self: flex-start; }
  .phero__title { display: flex; flex-direction: column; gap: 16px; }
  .phero__title .h1 { font-weight: 600; }
  .phero__lead { color: rgb(255 255 255 / 0.85); font-weight: 500; max-width: 600px; }
  .phero__buttons .btn--outline-light .icon { color: var(--orange-500); }
  .phero__bullets { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 14px; line-height: 22px; font-weight: 500; color: var(--sand-100); }
  .phero__bullets .icon { color: var(--blue-300); }
  .phero__media-mobile { display: none; }
  @media (max-width: 1279.98px) {
    .phero__inner { min-height: 640px; padding-bottom: 80px; }
    .phero::before { background: linear-gradient(90deg, #0f2d40 0%, rgb(15 45 64 / 0.85) 50%, rgb(15 45 64 / 0.45) 100%); }
  }
  @media (max-width: 767.98px) {
    .phero > picture { inset: auto 0 0 0; height: 380px; }
    .phero::before { background: linear-gradient(180deg, #0f2d40 0%, #0f2d40 calc(100% - 380px), rgb(15 45 64 / 0.55) calc(100% - 260px), rgb(15 45 64 / 0) 100%); }
    .phero__inner { min-height: 0; padding-top: calc(var(--masthead-h) + 24px); padding-bottom: 0; }
    .phero__copy { gap: 24px; }
    .phero__lead { font-size: 14px; line-height: 1.8; }
    .phero__bullets { flex-direction: column; gap: 8px; font-size: 12px; }
    .phero__media-mobile { display: block; height: 300px; }
  }
</style>
