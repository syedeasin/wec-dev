---
// Short navy hero with breadcrumb (legal pages, forms). Optional photo backdrop (Figma Forms hero).
import { Picture } from 'astro:assets';
import { img } from '../../lib/content';
interface Props { title: string; crumb: string; sub?: string; image?: string }
const { title, crumb, sub, image } = Astro.props;
const meta = image ? img(image) : undefined;
---
<section class:list={['chero on-dark', meta && 'chero--photo']}>
  {meta && (
    <div class="chero__bg" aria-hidden="true">
      <Picture src={meta} alt="" widths={[720, 1200, 1600, 2400].filter((w) => w <= meta.width)} sizes="100vw" formats={['webp']} fallbackFormat="webp" quality={85} loading="eager" />
    </div>
  )}
  <div class="container chero__inner">
    <nav class="chero__crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{crumb}</span></nav>
    <div class="chero__head">
      <h1 class="h1 chero__title" set:html={title} />
      {sub && <p class="chero__sub" set:html={sub} />}
    </div>
    <slot />
  </div>
</section>
<style is:global>
  .chero { position: relative; background: var(--gradient-navy); isolation: isolate; overflow: hidden; }
  .chero__inner { padding-top: calc(var(--masthead-h) + 60px); padding-bottom: 80px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .chero__head { display: flex; flex-direction: column; gap: 16px; }
  .chero__crumb { display: flex; gap: 8px; font-size: 14px; line-height: 22px; font-weight: 500; color: var(--sand-100); opacity: 0.8; }
  .chero__crumb a:hover { color: var(--orange-500); }
  .chero__sub { max-width: 760px; color: var(--sand-100); font-weight: 500; }
  .chero--photo { background: var(--navy-900); }
  .chero__bg { position: absolute; inset: 0; z-index: -1; }
  .chero__bg picture, .chero__bg img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0.44; }
  .chero__bg::after { content: ''; position: absolute; inset: 0; background:
    linear-gradient(269.69deg, rgb(15 45 64 / 0) 58.82%, rgb(15 45 64) 79.16%),
    linear-gradient(-0.18deg, rgb(15 45 64 / 0) 71.73%, rgb(15 45 64) 98.58%),
    linear-gradient(185.72deg, rgb(15 45 64 / 0) 56.79%, rgb(15 45 64 / .5) 74.38%, rgb(15 45 64) 87.78%); }
  @media (min-width: 1024px) {
    .chero--photo .chero__inner { min-height: 642px; justify-content: flex-end; gap: 24px; padding-bottom: 80px; }
    .chero--photo .chero__head + * { margin-top: 8px; }
  }
  @media (max-width: 767.98px) { .chero__inner { padding-top: calc(var(--masthead-h) + 32px); padding-bottom: 48px; } .chero__crumb { font-size: 12px; } }
</style>
