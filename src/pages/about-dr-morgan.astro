---
import SiteLayout from '../layouts/SiteLayout.astro';
import Tag from '../components/ui/Tag.astro';
import Icon from '../components/ui/Icon.astro';
import Title from '../components/blocks/Title.astro';
import Media from '../components/blocks/Media.astro';
import Callout from '../components/blocks/Callout.astro';
import Sections from '../components/blocks/Sections.astro';
import data from '../data/pages/about-dr-morgan.json';
import { icon, type PageData } from '../lib/content';
const d = data as PageData;
const [hero, sixteen, creds, ffk, three, home, goal] = d.sections;
const sp = sixteen.paras!;
const quote1 = sp.find((p) => p.w === 600)!;
const stats = [[creds.paras![0].t, creds.paras![1].t], [creds.paras![2].t, creds.paras![3].t]];
const fq = ffk.paras!.find((p) => p.w === 600)!;
const fRest = ffk.paras!.filter((p) => p !== fq);
const pairs = [0, 2, 4].map((i) => [three.paras![i].t, three.paras![i + 1].t]);
const hp = home.paras!;
---
<SiteLayout title="About Dr. Casey Morgan, D.C. | West End Chiropractic" description="Second-generation Austin chiropractor Casey Morgan, D.C. Practicing downtown since 2016 in a practice his family has run since 1994.">
  <section class="ahero on-dark">
    <div class="container ahero__grid">
      <div class="ahero__copy">
        <Tag variant="soft-dark">{hero.tag}</Tag>
        <h1 class="h1">{hero.title}</h1>
        <p class="ahero__lead" set:html={hero.paras![0].t} />
      </div>
      <Media image={hero.images![0]} class="ahero__img" eager shadow={false} sizes="(min-width: 1024px) 488px, 100vw" alt="Dr. Casey Morgan, D.C." />
    </div>
  </section>

  <section class="section section--sand sixteen">
    <div class="container sixteen__inner">
      <Title title={sixteen.title} center />
      {sp.slice(0, 2).map((p) => <p class="sixteen__p" set:html={p.t} />)}
      <figure class="qcard">
        <Media image={sixteen.images![0]} class="qcard__img" shadow={false} sizes="220px" alt="Dr. Casey Morgan" />
        <blockquote class="qcard__q" set:html={quote1.t} />
      </figure>
      <p class="sixteen__p fw-600" set:html={sp.at(-1)!.t} />
    </div>
  </section>

  <section class="section section--white creds">
    <div class="container creds__grid">
      <div class="creds__left">
        <Tag class="creds__tag">{creds.tag}</Tag>
        <h2 class="h2">{creds.title}</h2>
        <Media image={creds.images![0]} class="creds__img" shadow={false} sizes="(min-width: 1280px) 486px, (min-width: 1024px) 40vw, 100vw" />
      </div>
      <ul class="creds__list" role="list">
        {creds.cards!.map((c) => <li><span class="creds__icon"><Icon name={icon(c.icon)} size={24} /></span><div><h3 class="creds__t">{c.title}</h3><p class="creds__d">{c.text}</p></div></li>)}
      </ul>
    </div>
    <div class="container"><hr class="creds__rule" /><dl class="creds__stats">{stats.map(([n, l]) => <div><dt>{n}</dt><dd>{l}</dd></div>)}</dl></div>
  </section>

  <section class="section section--white about-ffk">
    <div class="container about-ffk__grid">
      <div class="about-ffk__copy">
        <Title title={ffk.title} />
        <p set:html={fRest[0].t} />
        <figure class="mini-q"><Media image={ffk.images![0]} class="mini-q__img" shadow={false} sizes="64px" alt="Dr. Casey Morgan" /><blockquote set:html={fq.t} /></figure>
        {fRest.slice(1).map((p) => <p set:html={p.t} />)}
        {ffk.callouts!.map((c) => <Callout title={c.title} text={c.text} />)}
      </div>
      <Media image={ffk.images![1]} class="about-ffk__img" shadow={false} sizes="(min-width: 1280px) 510px, (min-width: 1024px) 42vw, 100vw" alt="Dr. Casey Morgan pointing to a spine chart" />
    </div>
  </section>

  <section class="section section--white three">
    <div class="container three__inner">
      <h2 class="h2 text-center">{three.title}</h2>
      <ul class="three__grid" role="list">{pairs.map(([t, x]) => <li><h3 class="three__t">{t}</h3><p class="three__d" set:html={x} /></li>)}</ul>
    </div>
  </section>

  <section class="section section--white home-life">
    <div class="container home-life__grid">
      <Media image={home.images![0]} class="home-life__img" shadow={false} sizes="(min-width: 1280px) 510px, (min-width: 1024px) 42vw, 100vw" alt="Dr. Casey Morgan with his wife Rachel and daughter Saylor" />
      <div class="home-life__copy">
        <Title title={home.title} />
        {hp.slice(0, 3).map((p) => <p set:html={p.t} />)}
        <figure class="note-card"><p class="note-card__hand">{hp[3].t}</p><figcaption>{hp[4].t} <span class="note-card__pill">{hp[5].t}</span></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--sand goal">
    <div class="container goal__inner">
      <h2 class="h2 text-center">{goal.title}</h2>
      <figure class="qcard qcard--lg">
        <Media image={goal.images![0]} class="qcard__img" shadow={false} sizes="252px" alt="Dr. Casey Morgan" />
        <div><blockquote class="qcard__q" set:html={goal.paras![0].t} /><p class="qcard__cap" set:html={goal.paras![1].t} /></div>
      </figure>
    </div>
  </section>

  <Sections data={d} skip={[0, 1, 2, 3, 4, 5, 6]} />
</SiteLayout>
<style is:global>
  @font-face { font-family: 'Schoolbell'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/schoolbell-latin-400-normal.woff2') format('woff2'); }
</style>
<style>
  .ahero { background: var(--navy-900); }
  .ahero__grid { display: grid; gap: 40px; align-items: center; padding-top: calc(var(--masthead-h) + 40px); padding-bottom: 80px; }
  .ahero__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .ahero__copy .h1 { color: var(--sand-100); font-weight: 600; }
  .ahero__lead { color: rgb(255 255 255 / 0.8); font-size: 16px; line-height: 1.8; font-weight: 500; max-width: 512px; }
  .ahero :global(.ahero__img img) { aspect-ratio: 488 / 556; }
  @media (min-width: 1024px) { .ahero__grid { grid-template-columns: minmax(0, 512fr) minmax(0, 488fr); gap: 200px; } }
  @media (min-width: 1024px) and (max-width: 1279.98px) { .ahero__grid { gap: 80px; } }
  @media (max-width: 1023.98px) { .ahero :global(.ahero__img) { max-width: 488px; width: 100%; } }
  @media (max-width: 767.98px) { .ahero__grid { padding-top: calc(var(--masthead-h) + 24px); padding-bottom: 60px; } }

  .sixteen__inner { display: flex; flex-direction: column; align-items: center; gap: 32px; text-align: center; }
  .sixteen__p { max-width: 636px; font-size: 20px; line-height: 1.7; font-weight: 500; color: var(--navy-900); }
  .sixteen__inner > .sixteen__p + .sixteen__p:not(.fw-600) { margin-top: -8px; }
  .sixteen__p.fw-600 { font-weight: 500; }
  .qcard { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 0; max-width: 912px; width: 100%; background: var(--white); border-radius: var(--radius-xl); overflow: hidden; text-align: left; }
  .qcard :global(.qcard__img) { border-radius: 0; height: 100%; min-height: 257px; }
  .qcard :global(.qcard__img) { position: relative; }
  .qcard :global(.qcard__img picture), .qcard :global(.qcard__img img) { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; border-radius: 0; }
  .qcard__q { padding: 32px; font-size: 20px; line-height: 1.6; font-weight: 600; color: var(--navy-900); align-self: center; }
  .qcard--lg { grid-template-columns: 252px minmax(0, 1fr); }
  .qcard--lg :global(.qcard__img) { min-height: 307px; }
  .qcard--lg > div { padding: 32px; display: flex; flex-direction: column; gap: 16px; justify-content: center; }
  .qcard__cap { font-size: 16px; line-height: 1.8; color: var(--navy-900); }
  .qcard--lg .qcard__q { padding: 0; }
  @media (max-width: 767.98px) { .sixteen__p { font-size: 16px; } .qcard { grid-template-columns: 1fr; } .qcard :global(.qcard__img) { min-height: 0; aspect-ratio: 4 / 3; } .qcard__q { font-size: 16px; } .qcard__q, .qcard--lg > div { padding: 24px 16px; } }

  .creds__grid { display: grid; gap: 40px; align-items: center; }
  .creds__left { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .creds :global(.creds__tag) { background: rgb(44 83 109 / 0.12); color: var(--navy-600); }
  .creds__left .h2 { margin-bottom: 24px; }
  .creds :global(.creds__img) { width: 100%; }
  .creds :global(.creds__img img) { aspect-ratio: 486 / 305; }
  .creds__list { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .creds__list li { display: flex; gap: 16px; padding-block: 32px; border-bottom: 1px solid rgb(21 64 91 / 0.16); }
  .creds__list li:last-child { border-bottom: 0; }
  .creds__icon { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--radius-md); background: var(--sand-100); color: var(--orange-500); }
  .creds__t { font-size: 20px; line-height: 26px; font-weight: 600; margin-bottom: 8px; }
  .creds__d { font-size: 16px; line-height: 1.8; color: var(--navy-900); }
  .creds__rule { margin: 48px 0; border: 0; height: 1px; background: rgb(21 64 91 / 0.16); }
  .creds__stats { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px; border-radius: var(--radius-xl); background: var(--sand-100); }
  .creds__stats > div { padding: 32px; background: var(--white); border-radius: var(--radius-md); }
  .creds__stats dt { font-size: 32px; line-height: 1.2; font-weight: 700; }
  .creds__stats dd { margin: 8px 0 0; font-size: 20px; line-height: 26px; color: var(--navy-900); }
  @media (min-width: 1024px) { .creds__grid { grid-template-columns: minmax(0, 486fr) minmax(0, 588fr); gap: 126px; } }
  @media (min-width: 1024px) and (max-width: 1279.98px) { .creds__grid { gap: 60px; } }
  @media (max-width: 767.98px) { .creds__list li { padding-block: 24px; } .creds__icon { width: 48px; height: 48px; } .creds__t { font-size: 18px; } .creds__d { font-size: 14px; } .creds__rule { margin: 32px 0; } .creds__stats { gap: 8px; padding: 8px; } .creds__stats > div { padding: 16px; } .creds__stats dt { font-size: 24px; } .creds__stats dd { font-size: 14px; line-height: 22px; } }

  .about-ffk__grid { display: grid; gap: 40px; align-items: center; }
  .about-ffk__copy { display: flex; flex-direction: column; gap: 24px; font-size: 16px; line-height: 1.8; font-weight: 500; color: var(--navy-900); }
  .about-ffk :global(.about-ffk__img img) { aspect-ratio: 510 / 786; }
  .mini-q { display: flex; gap: 24px; align-items: flex-start; margin: 0; padding: 24px; border: 2px solid var(--sand-100); border-radius: var(--radius-md); font-weight: 600; font-size: 16px; line-height: 1.5; }
  .mini-q :global(.mini-q__img) { flex: none; width: 64px; height: 64px; border-radius: 50%; }
  .mini-q :global(.mini-q__img img) { border-radius: 50%; }
  @media (min-width: 1024px) { .about-ffk__grid { grid-template-columns: minmax(0, 588fr) minmax(0, 510fr); gap: 102px; } }
  @media (min-width: 1024px) and (max-width: 1279.98px) { .about-ffk__grid { gap: 60px; } }
  @media (max-width: 1023.98px) { .about-ffk :global(.about-ffk__img img) { aspect-ratio: 342 / 400; } }
  @media (max-width: 767.98px) { .about-ffk__copy { font-size: 14px; } .mini-q { padding: 16px; gap: 16px; font-size: 14px; } .mini-q :global(.mini-q__img) { width: 48px; height: 48px; } }

  .three__inner { display: flex; flex-direction: column; gap: 60px; }
  .three__grid { list-style: none; padding: 0; display: grid; border: 2px solid var(--sand-100); border-radius: var(--radius-xl); overflow: hidden; }
  .three__grid li { padding: 40px; display: flex; flex-direction: column; gap: 16px; color: var(--navy-900); }
  .three__grid li + li { border-top: 2px solid var(--sand-100); }
  .three__t { font-size: 20px; line-height: 26px; font-weight: 600; }
  .three__d { font-size: 16px; line-height: 1.8; }
  @media (min-width: 1024px) { .three__grid { grid-template-columns: repeat(3, 1fr); } .three__grid li + li { border-top: 0; border-left: 2px solid var(--sand-100); } }
  @media (max-width: 767.98px) { .three__grid li { padding: 24px 16px; } .three__inner { gap: 32px; } .three__t { font-size: 18px; } .three__d { font-size: 14px; } }

  .home-life__grid { display: grid; gap: 40px; align-items: center; }
  .home-life__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; font-size: 16px; line-height: 1.8; font-weight: 500; color: var(--navy-900); }
  .home-life__copy > :global(.btitle) { margin-bottom: 8px; }
  .home-life :global(.home-life__img img) { aspect-ratio: 510 / 562; }
  .note-card { margin: 8px 0 0; padding: 8px 16px; border-radius: var(--radius-xl); background: var(--sand-100); }
  .note-card__hand { font-family: 'Schoolbell', 'Bradley Hand', cursive; font-size: 28px; line-height: 1.8; }
  .note-card figcaption { font-family: 'Schoolbell', 'Bradley Hand', cursive; font-size: 20px; line-height: 1.8; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .note-card__pill { padding: 4px 8px; border: 1px solid var(--orange-500); border-radius: 24px; font-family: var(--font-sans); font-size: 11px; line-height: 1.8; font-weight: 500; color: var(--navy-900); }
  @media (min-width: 1024px) { .home-life__grid { grid-template-columns: minmax(0, 510fr) minmax(0, 588fr); gap: 102px; } }
  @media (min-width: 1024px) and (max-width: 1279.98px) { .home-life__grid { gap: 60px; } }
  @media (max-width: 767.98px) { .home-life__copy { font-size: 14px; } }

  .goal__inner { display: flex; flex-direction: column; align-items: center; gap: 60px; }
  @media (max-width: 767.98px) { .goal__inner { gap: 32px; } .qcard--lg { grid-template-columns: 1fr; } .qcard--lg :global(.qcard__img) { min-height: 0; } .qcard__cap { font-size: 14px; } }
</style>
