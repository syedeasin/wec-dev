---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import Icon from '../components/ui/Icon.astro';
import BulletItem from '../components/ui/BulletItem.astro';
import RatingRow from '../components/ui/RatingRow.astro';
import SpineMark from '../components/ui/SpineMark.astro';
import Deco from '../components/ui/Deco.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import VideoPopup from '../components/ui/VideoPopup.astro';
import Steps from '../components/sections/Steps.astro';
import AssessmentCTA from '../components/sections/AssessmentCTA.astro';
import CarAccidentBand from '../components/sections/CarAccidentBand.astro';
import Reviews from '../components/sections/Reviews.astro';
import InsuranceLogos from '../components/sections/InsuranceLogos.astro';
import FAQ from '../components/sections/FAQ.astro';
import Location from '../components/sections/Location.astro';
import CTABand from '../components/sections/CTABand.astro';
import { site } from '../data/site';
import { homeFaq, symptoms } from '../data/home';

import heroImg from '../assets/images/home/hero-casey-with-patient.webp';
import videoThumb from '../assets/images/home/video-thumb-adjustment.webp';
import painImg from '../assets/images/home/pain-adjustment-lower-back.webp';
import caseyPortrait from '../assets/images/team/casey-morgan-portrait.webp';
import caseySuit from '../assets/images/team/casey-morgan-suit.webp';
import caseyXray from '../assets/images/team/casey-morgan-xray-review.webp';
import taiImg from '../assets/images/team/tai-le.webp';
import gabbyImg from '../assets/images/team/gabby-menendez.webp';
import howImg from '../assets/images/home/how-it-works-adjustment.webp';
import newPatientImg from '../assets/images/home/new-patient-health-history.webp';

const caseySlides = [
  { src: caseyPortrait, alt: 'Dr. Casey Morgan, chiropractor at West End Chiropractic in downtown Austin' },
  { src: caseySuit, alt: 'Portrait of Dr. Casey Morgan in a navy suit' },
  { src: caseyXray, alt: 'Dr. Casey Morgan reviewing digital X-rays with a patient' },
];
---
<SiteLayout
  title="Chiropractor in Downtown Austin | West End Chiropractic"
  description="Downtown Austin chiropractor Dr. Casey Morgan finds the cause of your back, neck or headache pain, then fixes it. On-site digital X-rays, same-day visits, free parking."
>
  <!-- ============ HERO ============ -->
  <section class="hero on-dark">
    <Picture src={heroImg} alt="" widths={[640, 960, 1280, 1920, 2560, 2880]} sizes="100vw" formats={['webp']} fallbackFormat="webp" class="hero__bg" loading="eager" fetchpriority="high" />
    <div class="container hero__inner">
      <div class="hero__copy">
        <div class="hero__title">
          <Tag variant="soft-dark">Non-Surgical Treatment</Tag>
          <h1 class="h1">Downtown Austin chiropractic care that gets you <span class="hl">back to your life</span></h1>
          <p class="p2 hero__lead">If you’ve seen a chiropractor before and nothing changed, the problem probably never got found. Casey Morgan D.C. finds it first, then fixes it.</p>
        </div>
        <div class="hero__buttons">
          <Button href={site.bookHref} blockMobile>{site.bookLabel}</Button>
          <Button href={site.insuranceHref} variant="outline-light" icon="clipboard-check" blockMobile class="hero__verify">Verify My Insurance</Button>
        </div>
        <hr class="hero__rule" />
        <div class="hero__trust">
          <RatingRow />
          <ul class="hero__bullets" role="list">
            <BulletItem icon="fast-forward" size={20}>In and out in minutes, not rushed</BulletItem>
            <BulletItem icon="trust-x-ray" size={20}>Digital X-rays on site</BulletItem>
            <BulletItem icon="trust-calendar" size={20}>Same-day appointments available</BulletItem>
          </ul>
        </div>
      </div>
    </div>
    <div class="hero__media-mobile" aria-hidden="true"></div>
  </section>

  <!-- ============ VIDEO ============ -->
  <section class="section video-sec on-dark">
    <Deco opacity={0.02} style="right:-350px;top:0;transform:rotate(-32deg);transform-origin:top left" />
    <Deco opacity={0.02} style="left:-492px;top:21px;" />
    <div class="container">
      <div class="video-sec__card">
        <VideoPopup url={site.videos.meetTheDoctor} image={videoThumb} alt="Dr. Casey Morgan adjusting a patient" title="Play: a minute with Dr. Casey Morgan" class="video-sec__video" />
        <div class="video-sec__copy">
          <div class="stack-24">
            <Tag variant="soft-dark">Non-Surgical Treatment</Tag>
            <h2 class="h2 video-sec__title">A minute with the doctor you’ll actually be seeing.</h2>
            <ul class="bullet-list video-sec__list" role="list">
              <BulletItem icon="check" size={24}>5.0 stars, 250+ reviews</BulletItem>
              <BulletItem icon="check" size={24}>Free covered parking off MoPac</BulletItem>
              <BulletItem icon="check" size={24}>In-network with BCBS, UHC, Aetna and more</BulletItem>
            </ul>
          </div>
          <Button href={site.bookHref} class="hide-mobile">{site.bookLabel}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PAIN ============ -->
  <section class="section section--white pain">
    <div class="container split pain__split">
      <div class="pain__copy">
        <div class="stack-24">
          <h2 class="h2 pain__title"><SpineMark class="pain__mark" /><span>Pain that won’t let up <strong>wears you down</strong></span></h2>
          <div class="stack-16 pain__text">
            <p>When your back locks up during a meeting, or your neck stiffens at your desk, or a headache turns a Wednesday into a lost day, it’s not just discomfort. <strong>It’s your work, your workouts, your time with family. All of it takes a hit.</strong></p>
            <p class="fw-500">Most people push through it. They stretch. They pop ibuprofen. They tell themselves it will pass. Sometimes it does. Sometimes it doesn’t.</p>
            <p class="fw-600">If pain has been showing up more often, lasting longer, or getting worse, that’s a signal. Something structural is going on and it’s time to find out what.</p>
          </div>
        </div>
        <Button href={site.bookHref} blockMobile>{site.bookLabel}</Button>
      </div>
      <div class="pain__media">
        <Picture src={painImg} alt="Dr. Casey Morgan performing a lower back adjustment" widths={[360, 540, 800, 1040]} sizes="(min-width: 1280px) 519px, (min-width: 1024px) 45vw, 100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============ SYMPTOMS ============ -->
  <section class="section section--white symptoms">
    <div class="container stack symptoms__inner">
      <SectionHead title="What are you <strong>dealing with?</strong>" class="symptoms__head">
        Find your symptom below and we’ll show you how we treat it. Not sure which one fits? Just call us.
      </SectionHead>
      <div class="symptoms__grid">
        {symptoms.map((col, c) => (
          <ul class:list={['symptoms__col', `symptoms__col--${c}`]} role="list">
            {col.map((s) => (
              <li class:list={{ 'symptoms__half': s.half }}><a href={s.href} class="chip-link"><span>{s.label}</span><Icon name="arrow-up-right" size={12} /></a></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CASEY + TEAM ============ -->
  <section class="section section--white casey">
    <div class="container casey__inner">
      <div class="casey__split">
        <div class="casey__media" data-carousel>
          <div class="casey__track">
            {caseySlides.map((s, i) => (
              <figure class:list={['casey__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
                <Picture src={s.src} alt={s.alt} widths={[360, 488, 720, 976]} sizes="(min-width: 1280px) 488px, (min-width: 1024px) 40vw, 100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
              </figure>
            ))}
          </div>
          <div class="dots" role="tablist" aria-label="Photos of Dr. Morgan">
            {caseySlides.map((_, i) => <button type="button" class:list={['dots__dot', { 'is-active': i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Photo ${i + 1}`} data-dot={i}></button>)}
          </div>
        </div>
        <div class="casey__copy">
          <h2 class="h2 casey__title">Casey Morgan D.C.<br />Second-generation<br />Austin chiropractor</h2>
          <div class="stack-16 casey__text">
            <p>Dr. Morgan grew up noticing two things. Other kids were always going to the doctor and he never was. And his dad loved going to work every single day. At sixteen he decided he’d be a chiropractor too.</p>
            <p>Parker University graduate. Board Certified by the NBCE. Second generation. Adjusting patients in downtown Austin since 2016.</p>
            <p>His approach is simple. Find the actual cause. Fix it. Then keep it from coming back.</p>
            <p class="fw-600">If you’ve been to a chiropractor who just cracked you and sent you out, this will feel different.</p>
          </div>
          <Button variant="tertiary" href="/about-dr-morgan">Read Casey’s full story</Button>
        </div>
      </div>

      <div class="team-row">
        <h2 class="h3 team-row__title">The people who make the visit easy</h2>
        <div class="team-row__grid">
          <article class="person">
            <Picture src={taiImg} alt="Tai Le, chiropractic assistant" widths={[132, 264]} sizes="132px" formats={['webp']} fallbackFormat="webp" loading="lazy" class="person__img" />
            <div class="person__body">
              <h3 class="person__name">Tai Le</h3>
              <p class="person__role">Chiropractic Assistant</p>
              <p class="person__bio">With West End since 2017, which makes him the person here longest besides Casey. UT grad in kinesiology, plays tennis, and good odds he’s the one who answers when you call.</p>
            </div>
          </article>
          <article class="person">
            <Picture src={gabbyImg} alt="Gabriella “Gabby” Menendez, chiropractic assistant" widths={[132, 264]} sizes="132px" formats={['webp']} fallbackFormat="webp" loading="lazy" class="person__img" />
            <div class="person__body">
              <h3 class="person__name">Gabriella "Gabby" Menendez</h3>
              <p class="person__role">Chiropractic Assistant</p>
              <p class="person__bio">Came to Austin from New Orleans at the end of 2025, already a chiropractic assistant. Most people relax before they even sit down. Outside work: books, movies, and capybaras.</p>
            </div>
          </article>
        </div>
        <Button variant="tertiary" href="/our-team">Meet the full team</Button>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="how on-dark">
    <Picture src={howImg} alt="" widths={[640, 960, 1440, 2160, 2880]} sizes="100vw" formats={['webp']} fallbackFormat="webp" class="how__bg" loading="lazy" />
    <Deco opacity={0.04} style="right:-360px;top:5px;" class="hide-mobile" />
    <div class="container how__inner">
      <div class="how__media-mobile">
        <Picture src={caseyXray} alt="Dr. Casey Morgan explaining X-ray results to a patient" widths={[360, 720]} sizes="100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
      </div>
      <div class="how__copy">
        <h2 class="h2 how__title">How it works</h2>
        <Steps steps={[
          { title: 'Book your visit', text: 'Book online or give us a call. Send us your insurance info and we’ll look into your coverage before your visit. Same-day appointments are usually available.' },
          { title: 'Get an evaluation', text: 'Your first visit includes an exam, any necessary digital X-rays, and your first adjustment. Dr. Morgan takes time to actually understand what’s going on before recommending anything.' },
          { title: 'Get a plan', text: 'A few days later, Dr. Morgan walks you through what he found, what he recommends, and what it costs. Then you decide.' },
        ]} />
      </div>
    </div>
  </section>

  <!-- ============ NEW PATIENT ============ -->
  <section class="section section--sand first-visit">
    <div class="container first-visit__inner">
      <SectionHead title="<strong>New patient?<br>Here is your first visit.</strong>" maxWidth={572}>Your exam, a consultation, and any necessary digital X-rays.</SectionHead>
      <div class="first-visit__card">
        <ul class="first-visit__grid" role="list">
          <li><FeatureCard icon="file-text" title="Full history and exam">We ask what hurts, what you have already tried, and what you want back.</FeatureCard></li>
          <li><FeatureCard icon="person-standing" title="Digital X-rays">Any imaging you need happens in-office. No referral, no separate bill.</FeatureCard></li>
          <li><FeatureCard icon="eye" title="Dr. Morgan reviews your case personally">Not a tech, not an assistant. Dr. Morgan reads your X-rays and makes the call.</FeatureCard></li>
          <li><FeatureCard icon="thumbs-up" title="Honest recommendation">If decompression fits, you get the plan and pricing. If not, we say so.</FeatureCard></li>
        </ul>
        <div class="first-visit__media">
          <Picture src={newPatientImg} alt="New patient filling out a health history form on a clipboard" widths={[360, 488, 720, 976]} sizes="(min-width: 1280px) 488px, (min-width: 1024px) 40vw, 100vw" formats={['webp']} fallbackFormat="webp" loading="lazy" />
        </div>
      </div>
      <div class="first-visit__actions">
        <div class="first-visit__buttons">
          <Button href={site.bookHref} blockMobile>{site.bookLabel}</Button>
          <Button href={site.phoneHref} variant="secondary" icon="phone" blockMobile class="btn--plain">Or call {site.phone}</Button>
        </div>
        <p class="a2 first-visit__note">Paying yourself? Call us or ask when you book and we’ll tell you the cost up front.</p>
      </div>
    </div>
  </section>

  <AssessmentCTA />

  <!-- ============ SERVICES ============ -->
  <section class="section section--navy-gradient on-dark services">
    <div class="container services__inner">
      <SectionHead title="Everything Dr. Morgan<br>does <strong>at West End</strong>">Not every problem needs the same fix. <strong>Here’s how we help.</strong></SectionHead>
      <div class="services__grid">
        <ServiceCard icon="workout" title="Chiropractic Adjustments" href="/services/chiropractic-adjustments">Manual, hands-on adjustments that get to the actual cause of pain. No cracking-and-praying.</ServiceCard>
        <ServiceCard icon="baby" title="Pregnancy Chiropractic Care" href="/conditions/pregnancy-chiropractic">Gentle, safe care during pregnancy. We work alongside your OB or midwife.</ServiceCard>
        <ServiceCard icon="spine" title="Non-Surgical Spinal Decompression" href="/services/spinal-decompression">For herniated or bulging discs. A non-surgical option that starts with imaging, not guesswork.</ServiceCard>
        <ServiceCard icon="laptop" title="Desk & Tech Neck Care" href="/conditions/neck-pain/tech-neck">Neck, shoulder and upper back pain from long hours at a screen. The most common thing we see in downtown Austin.</ServiceCard>
        <ServiceCard icon="person-standing" title="Digital X-Rays (On-Site)" href="/services/digital-x-ray">Fast, low-radiation imaging right in the office. See what’s happening before we recommend anything.</ServiceCard>
        <ServiceCard icon="car" title="Auto Accident Care" href="/services-treatments/auto-accident/">Same-day appointments. We bill PIP, letters of protection, and third-party auto claims.</ServiceCard>
      </div>
    </div>
  </section>

  <CarAccidentBand />

  <Reviews page="home" />

  <!-- ============ INSURANCE ============ -->
  <section class="section insurance">
    <div class="container insurance__inner">
      <SectionHead title="Insurance?<br><strong>We’ve got you covered</strong>" maxWidth={618}>
        <span slot="before" class="itile itile--blue insurance__icon"><Icon name="shield-check" size={24} /></span>
        We’re in-network with most major insurance carriers in Austin. Send us your insurance info when you book and we’ll look into your coverage before your first visit.
      </SectionHead>
      <div class="insurance__grid">
        <InsuranceLogos />
        <p class="a2 insurance__note">We do not accept Medicaid. We accept Medicare and Medicare Advantage plans. HMO patients require a referral. CIGNA is accepted out-of-network only.</p>
        <Button href={site.insuranceHref} variant="secondary" icon="clipboard-check" class="insurance__btn">Verify My Insurance</Button>
      </div>
    </div>
  </section>

  <FAQ items={homeFaq} />
  <Location />
  <CTABand />
</SiteLayout>

<script>
  // Casey photo carousel: dots + swipe, auto-advance paused on hover/focus.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let i = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('is-active', k === i); s.toggleAttribute('aria-hidden', k !== i); });
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === i); d.setAttribute('aria-selected', String(k === i)); });
    };
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    let x0 = 0;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1)); });
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: hidden; background: var(--navy-900); }
  .hero :global(.hero__bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 75% 50%; }
  .hero :global(picture) { position: absolute; inset: 0; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, #0f2d40 0%, rgb(15 45 64 / 0.92) 28%, rgb(15 45 64 / 0.35) 55%, rgb(15 45 64 / 0) 75%),
      linear-gradient(180deg, rgb(15 45 64 / 0) 55%, #0f2d40 100%),
      rgb(15 45 64 / 0.24); }
  .hero__inner { position: relative; padding-top: calc(var(--masthead-h) + 60px); padding-bottom: 120px; min-height: 880px; display: flex; align-items: center; }
  .hero__copy { display: flex; flex-direction: column; gap: 32px; max-width: 758px; }
  .hero__title { display: flex; flex-direction: column; gap: 16px; }
  .hero__title .h1 { max-width: 737px; font-weight: 500; }
  .hero__lead { color: rgb(255 255 255 / 0.8); font-weight: 500; max-width: 640px; }
  .hero__buttons { display: flex; flex-wrap: wrap; gap: 16px; }
  .hero :global(.hero__verify .icon) { color: var(--orange-500); }
  .hero__rule { width: 64px; border: 0; height: 1px; background: rgb(255 255 255 / 0.08); }
  .hero__trust { display: flex; flex-direction: column; gap: 16px; }
  .hero__bullets { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 14px; line-height: 22px; font-weight: 500; color: var(--sand-100); }
  .hero__bullets :global(.icon) { color: var(--blue-300); }
  .hero__media-mobile { display: none; }

  @media (max-width: 1279.98px) {
    .hero__inner { min-height: 0; padding-bottom: 80px; }
    .hero::before { background: linear-gradient(90deg, #0f2d40 0%, rgb(15 45 64 / 0.85) 50%, rgb(15 45 64 / 0.4) 100%), linear-gradient(180deg, rgb(15 45 64 / 0) 55%, #0f2d40 100%); }
  }
  @media (max-width: 767.98px) {
    /* Mobile: copy on navy, photo below with a fade (matches Figma mobile) */
    .hero :global(picture) { inset: auto 0 0 0; height: 451px; top: auto; }
    .hero :global(.hero__bg) { position: absolute; object-position: 77% 50%; }
    .hero::before { background: linear-gradient(180deg, #0f2d40 0%, #0f2d40 calc(100% - 451px), rgb(15 45 64 / 0.6) calc(100% - 330px), rgb(15 45 64 / 0) 100%); }
    .hero__inner { padding-top: calc(var(--masthead-h) + 24px); padding-bottom: 0; }
    .hero__copy { gap: 24px; }
    .hero__lead { font-size: 14px; line-height: 1.8; }
    .hero__buttons { flex-direction: column; gap: 12px; }
    .hero__rule { width: auto; margin-inline: calc(-1 * var(--gutter)); }
    .hero__bullets { flex-direction: column; gap: 8px; font-size: 12px; }
    .hero__media-mobile { display: block; height: 340px; }
  }

  /* ---------- Video ---------- */
  .video-sec { position: relative; overflow: hidden; isolation: isolate; background: var(--navy-900); padding-top: 80px; }
  .video-sec__card { position: relative; z-index: 1; display: grid; gap: 40px; padding: 40px; background: var(--navy-750); border-radius: var(--radius-xl); align-items: center; }
  .video-sec :global(.video-sec__video) { aspect-ratio: 519 / 571; }
  .video-sec__copy { display: flex; flex-direction: column; gap: 32px; align-items: flex-start; }
  .video-sec__title { font-weight: 600; color: var(--sand-100); }
  .video-sec__list { font-size: 16px; line-height: 1.8; font-weight: 600; color: var(--sand-100); }
  .video-sec__list :global(.icon) { color: var(--orange-500); }
  @media (min-width: 1024px) {
    .video-sec__card { grid-template-columns: minmax(0, 519px) minmax(0, 521px); justify-content: space-between; gap: 80px; }
    .video-sec__title { max-width: 440px; }
  }
  @media (max-width: 1023.98px) {
    .video-sec__copy { order: -1; }
    .video-sec :global(.video-sec__video) { aspect-ratio: 310 / 343; max-height: 520px; width: 100%; }
  }
  @media (max-width: 767.98px) {
    .video-sec { padding-top: 0; padding-bottom: 0; }
    .video-sec__card { padding: 24px 12px 12px; gap: 24px; margin-bottom: 60px; }
    .video-sec__copy { padding-inline: 8px; }
    .video-sec__title { font-size: 20px; line-height: 1.2; }
    .video-sec__list { font-size: 14px; line-height: 1.6; gap: 12px; }
    .video-sec__list :global(.bullet--24) { --bsz: 20px; }
    .video-sec__list :global(.icon) { width: 20px; height: 20px; }
  }

  /* ---------- Pain ---------- */
  .pain__split { gap: 40px; }
  .pain__copy { display: flex; flex-direction: column; gap: 32px; align-items: flex-start; padding-block: 24px; }
  .pain__title { display: flex; align-items: center; gap: 24px; font-weight: 500; }
  .pain__title strong { font-weight: 700; }
  .pain :global(.pain__mark) { color: var(--blue-300); opacity: 0.4; }
  .pain :global(.pain__mark svg) { height: 80px; width: auto; }
  .pain__text { color: var(--navy-900); }
  .pain__text strong { font-weight: 600; }
  .pain__media { border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-image); }
  .pain__media :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 519 / 571; }
  @media (min-width: 1024px) { .pain__split { grid-template-columns: minmax(0, 557px) minmax(0, 519px); justify-content: space-between; gap: 80px; } }
  @media (max-width: 1023.98px) { .pain__media { order: 2; } .pain__media :global(img) { aspect-ratio: 342 / 359; } }
  @media (max-width: 767.98px) {
    .pain { padding-top: 60px; padding-bottom: 0; }
    .pain__copy { padding-block: 0; }
    .pain__title { gap: 16px; }
    .pain :global(.pain__mark svg) { height: 64px; }
  }

  /* ---------- Symptoms ---------- */
  .symptoms__inner { gap: 60px; }
  .symptoms__grid { display: grid; gap: 16px; }
  .symptoms__col { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-content: start; }
  .symptoms__col > li { grid-column: 1 / -1; }
  .symptoms__col > li.symptoms__half { grid-column: auto; }
  .chip-link { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 58px; padding: 12px 16px; border: 2px solid var(--sand-100); border-radius: var(--radius-xl);
    font-size: 14px; line-height: 1.2; font-weight: 600; color: var(--navy-900); transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease); }
  .chip-link :global(.icon) { flex: none; color: var(--navy-900); transition: transform var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
