---
// Credentials & Compliance — laid out to Figma 12617:9457 (TOC card + 820px body, ruled sections).
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import CompactHero from '../components/blocks/CompactHero.astro';
import LegalToc from '../components/blocks/LegalToc.astro';
import Icon from '../components/ui/Icon.astro';
import data from '../data/pages/credentials-compliance.json';
import { img, strip } from '../lib/content';
import { site } from '../data/site';
const hero = data.sections[0];
const crumb = strip(hero.paras?.[0]?.t ?? '').split('/').pop()!.trim();
const docs = {
  license: img('photos/credential-tbce-license'),
  tele: img('photos/credential-florida-telehealth'),
  notice: img('photos/credential-notice-public'),
};
const toc = [
  { id: 'chiropractic-license', label: 'Chiropractic License' },
  { id: 'florida-telehealth-certification', label: 'Florida Telehealth Certification' },
  { id: 'notice-to-public', label: 'Notice To Public' },
  { id: 'filing-a-complaint', label: 'Filing A Complaint' },
  { id: 'requesting-medical-records', label: 'Requesting Medical Records' },
];
const w = (m: ImageMetadata) => [400, 600, 800, 1200, 1640].filter((x) => x <= m.width).concat(m.width < 1640 ? [m.width] : []);
---
<SiteLayout title="Credentials & Compliance | West End Chiropractic" description="Dr. Casey Morgan's Texas chiropractic license, Florida telehealth certification, notice to the public, complaints and medical records requests.">
  <CompactHero title={hero.title ?? ''} crumb={crumb} sub={hero.paras?.[1]?.t} image="photos/office-sign-hero" />
  <section class="section section--white legal cred">
    <div class="container legal__grid">
      <LegalToc items={toc} />
      <div class="cred__body">
        <section class="cred__sec" id="chiropractic-license">
          <h2 class="cred__h">Chiropractic License</h2>
          <p class="cred__lead">Dr. Casey Morgan holds a valid and active license to practice chiropractic in the state of Texas.</p>
          <div class="cred__details">
            <div><p class="cred__k">LICENSEE NAME</p><p class="cred__v">Casey Morgan</p></div>
            <div><p class="cred__k">LICENSE NUMBER</p><p class="cred__v">12254</p></div>
          </div>
          <p>To verify this license, please visit the official website of the Texas Board of Chiropractic Examiners:</p>
          <a class="cred__link" href="https://www.tbce.texas.gov/" target="_blank" rel="noopener">Texas Board of Chiropractic Examiners License Verification<Icon name="arrow-up-right" size={16} /></a>
          <div class="cred__doc cred__doc--wide"><Picture src={docs.license} alt="Texas Board of Chiropractic Examiners license certificate for Casey Morgan, D.C." widths={w(docs.license)} sizes="(min-width: 1024px) 820px, 100vw" formats={['webp']} fallbackFormat="webp" quality={90} loading="lazy" /></div>
        </section>
        <section class="cred__sec" id="florida-telehealth-certification">
          <h2 class="cred__h">Florida Telehealth Certification</h2>
          <p class="cred__lead">Dr. Casey Morgan is certified to provide telehealth services in Florida.</p>
          <a class="cred__link" href="https://flhealthsource.gov/telehealth/" target="_blank" rel="noopener">Florida Telehealth Page<Icon name="arrow-up-right" size={16} /></a>
          <div class="cred__doc"><Picture src={docs.tele} alt="Florida Department of Health telehealth provider registration letter" widths={w(docs.tele)} sizes="(min-width: 1024px) 820px, 100vw" formats={['webp']} fallbackFormat="webp" quality={90} loading="lazy" /></div>
        </section>
        <section class="cred__sec" id="notice-to-public">
          <h2 class="cred__h">Notice To Public</h2>
          <p>For detailed information regarding the rules and regulations governing chiropractic practice in Texas, please refer to the official website of the Texas Board of Chiropractic Examiners:</p>
          <div class="cred__doc"><Picture src={docs.notice} alt="Mandatory notice to the public: complaints against a licensee should be made to the Texas Board of Chiropractic Examiners" widths={w(docs.notice)} sizes="(min-width: 1024px) 820px, 100vw" formats={['webp']} fallbackFormat="webp" quality={90} loading="lazy" /></div>
        </section>
        <section class="cred__sec" id="filing-a-complaint">
          <h2 class="cred__h">Filing A Complaint</h2>
          <p>To file a complaint regarding chiropractic services provided in Texas:</p>
          <ol class="cred__list" role="list">
            <li><span class="cred__n">1</span><p>Contact the Texas Board of Chiropractic Examiners.</p></li>
            <li><span class="cred__n">2</span><p>Complaints may be submitted online through the Board’s complaint portal.</p></li>
          </ol>
          <div class="cred__card">
            <p class="cred__card-t">Texas Board of Chiropractic Examiners</p>
            <p>1801 Congress Ave., Ste. 10.500</p>
            <p>Austin, TX 78701</p>
            <p><a href="tel:+15123056700">512-305-6700</a></p>
            <a class="cred__link cred__link--sm" href="https://www.tbce.texas.gov/complaint.html" target="_blank" rel="noopener">https://www.tbce.texas.gov/complaint.html<Icon name="arrow-up-right" size={16} /></a>
          </div>
        </section>
        <section class="cred__sec" id="requesting-medical-records">
          <h2 class="cred__h">Requesting Medical Records</h2>
          <p>To request copies of your medical records from West End Chiropractic:</p>
          <ol class="cred__list" role="list">
            <li><span class="cred__n">1</span><p>Submit a written request by email, mail, or in person.</p></li>
            <li><span class="cred__n">2</span><p>Include your full name, date of birth, phone number, approximate dates of treatment, and preferred delivery method.</p></li>
            <li><span class="cred__n">3</span><p>Send requests to:</p></li>
          </ol>
          <div class="cred__card">
            <p class="cred__card-t">West End Chiropractic</p>
            <p>1611 W. 5th St. STE 110</p>
            <p>Austin, TX 78703</p>
            <p><a href={site.phoneHref}>512-472-1116</a></p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <p class="cred__note">A valid government-issued photo ID may be required prior to release of records. Records are released in accordance with applicable Texas law and HIPAA requirements.</p>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
<style is:global>
  .cred { padding: 100px 0 140px; }
  .cred .legal__grid { display: grid; gap: 40px; align-items: start; }
  .cred__body { display: flex; flex-direction: column; gap: 48px; min-width: 0; }
  .cred__sec { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; scroll-margin-top: 24px; }
  .cred__sec + .cred__sec { padding-top: 48px; border-top: 1px solid #e4dfd4; }
  .cred__sec > p { font-size: 16px; line-height: 1.8; color: var(--navy-600); }
  .cred__h { font-size: 32px; line-height: 1.2; font-weight: 600; color: var(--navy-900); }
  .cred__sec > .cred__lead { font-weight: 600; color: var(--navy-900); }
  .cred__details { align-self: stretch; display: flex; flex-wrap: wrap; gap: 16px 48px; padding: 20px 24px; border-radius: 12px; background: var(--sand-100); }
  .cred__details > div { display: flex; flex-direction: column; gap: 4px; }
  .cred__k { font-size: 12px; line-height: 22px; font-weight: 700; color: rgb(44 83 109 / .8); }
  .cred__v { font-size: 20px; line-height: 26px; font-weight: 600; color: var(--navy-900); }
  .cred__link { display: inline; font-size: 16px; line-height: 1.8; font-weight: 600; color: var(--orange-500); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .cred__link .icon { display: inline-block; vertical-align: -2px; margin-left: 6px; }
  .cred__link--sm { font-size: 14px; line-height: 22px; padding-top: 8px; }
  .cred__doc { align-self: stretch; position: relative; aspect-ratio: 820 / 1062; border-radius: 16px; overflow: hidden; border: 1px dashed #c9c2b3; background: #fff; }
  .cred__doc--wide { aspect-ratio: 820 / 467; }
  .cred__doc picture, .cred__doc img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cred__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; align-self: stretch; }
  .cred__list li { display: flex; gap: 14px; align-items: flex-start; }
  .cred__list p { font-size: 16px; line-height: 1.8; color: var(--navy-600); }
  .cred__n { flex: none; width: 26px; height: 26px; border-radius: 6px; background: var(--orange-500); color: #fff; font-size: 12px; line-height: 22px; font-weight: 700; display: grid; place-items: center; }
  .cred__card { align-self: stretch; display: flex; flex-direction: column; gap: 4px; padding: 20px 24px; border-radius: 12px; background: var(--sand-100); }
  .cred__card p { font-size: 16px; line-height: 1.8; color: var(--navy-600); }
  .cred__card a:not(.cred__link):hover { color: var(--orange-500); }
  .cred__card .cred__card-t { font-weight: 600; color: var(--navy-900); }
  .cred__sec > .cred__note { font-size: 14px; line-height: 22px; color: rgb(44 83 109 / .85); }
  @media (min-width: 1024px) { .cred .legal__grid { grid-template-columns: 300px minmax(0, 820px); gap: 80px; } }
  @media (max-width: 767.98px) {
    .cred { padding: 48px 0 80px; }
    .cred__body { gap: 40px; }
    .cred__sec + .cred__sec { padding-top: 40px; }
    .cred__h { font-size: 24px; }
    .cred__details { padding: 16px; }
    .cred__card { padding: 16px; }
  }
</style>
