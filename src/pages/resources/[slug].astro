---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Media from '../../components/blocks/Media.astro';
import RelatedBlock from '../../components/blocks/RelatedBlock.astro';
import ArticleCard from '../../components/blocks/ArticleCard.astro';
import CTABand from '../../components/sections/CTABand.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { articles, fmtDate } from '../../data/articles';
import { site } from '../../data/site';
import postData from '../../data/pages/resource-post.json';
import type { PageData } from '../../lib/content';

export async function getStaticPaths() {
  const files = import.meta.glob<any>('../../articles/*.md', { eager: true });
  return Object.entries(files).map(([path, mod]) => ({ params: { slug: path.split('/').pop()!.replace('.md', '') }, props: { mod } }));
}
const { mod } = Astro.props;
const fm = mod.frontmatter;
const { Content } = mod;
const headings: { depth: number; slug: string; text: string }[] = mod.getHeadings();
const slug = Astro.params.slug;
const pd = postData as PageData;
// Related conditions: the cards from the design, filtered to the ones the article lists.
const relSection = { ...pd.sections[4], cards: pd.sections[4].cards!.filter((c) => (fm.related ?? []).includes(c.title)) };
const keep = articles.filter((a) => a.slug !== slug && a.topic === fm.topic).slice(0, 4);
const url = new URL(Astro.url.pathname, site.url).href;
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: fm.title, description: fm.description, datePublished: fm.date, dateModified: fm.date,
  author: { '@type': 'Person', name: 'Casey Morgan', honorificSuffix: 'D.C.' }, publisher: { '@type': 'MedicalBusiness', name: site.name }, mainEntityOfPage: url };
const cta = pd.sections.at(-1)!;
---
<SiteLayout title={`${fm.title} | West End Chiropractic`} description={fm.description} headerVariant="solid">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <article>
    <header class="section section--white phead">
      <div class="container phead__inner">
        <nav class="phead__crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/resources">Resources</a><span>/</span><span aria-current="page">{fm.topic}</span></nav>
        <p class="eyebrow phead__topic">{fm.topic}</p>
        <h1 class="h1 phead__title">{fm.title}</h1>
        <p class="phead__lead">{fm.description}</p>
        <div class="phead__by">
          <Media image={{ src: 'photos/casey-morgan-headshot', w: 1, h: 1, pos: '50% 20%' }} class="phead__avatar" shadow={false} sizes="48px" alt="Casey Morgan, D.C." />
          <div><p class="fw-600">By Casey Morgan, D.C.</p><p class="a2 text-muted">Updated {fmtDate(fm.date)}  ·  {fm.minutes} min read</p></div>
          <button type="button" class="phead__share" data-share><Icon name="arrow-up-right" size={16} />Share</button>
        </div>
      </div>
    </header>
    <figure class="container pfig">
      <Media image={{ src: fm.image, w: 1, h: 1, pos: fm.imagePos }} eager sizes="(min-width: 1280px) 1280px, 100vw" alt={fm.caption} />
      <figcaption class="a2 text-muted">{fm.caption}</figcaption>
    </figure>
    <div class="container pbody">
      <aside class="pbody__side">
        <div class="pbox"><p class="eyebrow">In this article</p><ol role="list">{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></div>
        <div class="pbox pbox--cta">
          <p class="eyebrow phead__topic">New patients</p>
          <p class="h4">Not sure what's causing your pain?</p>
          <p class="a1 text-muted">Your first visit includes an exam and any digital X-rays you need. In-network with most major carriers.</p>
          <Button href={site.bookHref} block>{site.bookLabel}</Button>
          <a class="pbox__call" href={site.phoneHref}>Or call {site.phone}</a>
        </div>
      </aside>
      <div class="pbody__main">
        <div class="pkey"><p class="pkey__title">Key takeaways</p><ul role="list">{fm.takeaways.map((t: string) => <li><Icon name="check" size={16} /><span>{t}</span></li>)}</ul></div>
        <div class="prose post-prose"><Content /></div>
        <p class="pnote a2">This article is general information, not a diagnosis. If you have sudden leg weakness, numbness in the groin or inner thighs, or trouble controlling your bladder or bowels, get emergency care right away.</p>
        <div class="ptags"><span class="fw-600">Filed under</span>{fm.tags.map((t: string) => <span class="ptag">{t}</span>)}</div>
        <div class="pauthor">
          <Media image={{ src: 'photos/casey-morgan-headshot', w: 1, h: 1, pos: '50% 20%' }} class="pauthor__img" shadow={false} sizes="64px" alt="Casey Morgan, D.C." />
          <div><p class="eyebrow text-muted">Written and reviewed by</p><p class="fw-600">Casey Morgan, D.C.</p><p class="a2 text-muted">Chiropractor at West End Chiropractic, downtown Austin</p><p class="a1">Dr. Morgan writes these guides to answer the questions patients ask him most, in plain English.</p><a class="text-link" href="/about-dr-morgan">More from Dr. Morgan →</a></div>
        </div>
      </div>
    </div>
  </article>
  {relSection.cards.length > 0 && <RelatedBlock s={relSection} />}
  {keep.length > 0 && (
    <section class="section section--white">
      <div class="container pkeep">
        <div class="pkeep__head"><div><p class="eyebrow phead__topic">More on {fm.topic}</p><h2 class="h2">Keep reading</h2></div><a class="text-link" href="/resources">See all {fm.topic} articles →</a></div>
        <ul class="rgrid-4" role="list">{keep.map((a) => <li><ArticleCard a={a} /></li>)}</ul>
      </div>
    </section>
  )}
  <CTABand title={cta.title} text={cta.paras![0].t} />
</SiteLayout>
<script>
  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    try { if (navigator.share) await navigator.share({ title: document.title, url: location.href }); else { await navigator.clipboard.writeText(location.href); alert('Link copied'); } } catch {}
  });
</script>
<style>
  .phead { padding-bottom: 40px; }
  .phead__inner { display: flex; flex-direction: column; gap: 16px; max-width: 860px; }
  .phead__crumb { display: flex; gap: 8px; flex-wrap: wrap; font-size: 13px; color: var(--navy-600); }
  .phead__crumb a:hover { color: var(--orange-500); }
  .phead__topic { color: var(--orange-500); }
  .phead__lead { font-size: var(--fs-p1); line-height: var(--lh-p1); color: var(--navy-600); }
  .phead__by { display: flex; align-items: center; gap: 12px; margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border-light); }
  .phead :global(.phead__avatar) { width: 48px; height: 48px; border-radius: 50%; flex: none; }
  .phead__share { margin-left: auto; display: inline-flex; gap: 6px; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--border-light); border-radius: var(--radius-full); font-size: 14px; line-height: 1; font-weight: 600; }
  .pfig { display: flex; flex-direction: column; gap: 8px; }
  .pfig :global(img) { aspect-ratio: 16 / 7; }
  .pbody { display: grid; gap: 40px; padding-block: 60px 100px; align-items: start; }
  .pbody__side { display: flex; flex-direction: column; gap: 24px; }
  .pbox { padding: 24px; border-radius: var(--radius-xl); background: var(--sand-100); display: flex; flex-direction: column; gap: 12px; }
  .pbox ol { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px; font-weight: 500; }
  .pbox a:hover { color: var(--orange-500); }
  .pbox--cta { background: var(--white); border: 1px solid var(--border-light); }
  .pbox__call { text-align: center; font-weight: 600; color: var(--orange-500); font-size: 14px; }
  .pbody__main { display: flex; flex-direction: column; gap: 32px; max-width: 760px; }
  .pkey { padding: 24px; border-radius: var(--radius-xl); border-left: 3px solid var(--orange-500); background: var(--sand-100); }
  .pkey__title { font-weight: 700; margin-bottom: 12px; }
  .pkey ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .pkey li { display: flex; gap: 10px; }
  .pkey :global(.icon) { flex: none; margin-top: 5px; color: var(--orange-500); }
  .post-prose { font-size: 17px; line-height: 1.8; color: var(--navy-900); }
  .post-prose :global(h2) { font-size: var(--fs-h3); line-height: 1.2; scroll-margin-top: 80px; }
  .post-prose :global(blockquote) { margin: 32px 0; padding: 24px; border-radius: var(--radius-xl); background: var(--navy-900); color: var(--white); font-size: var(--fs-p1); line-height: 1.5; font-weight: 600; }
  .post-prose :global(blockquote p + p) { margin-top: 12px; font-size: 14px; color: var(--orange-500); }
  .post-prose :global(li::marker) { color: var(--orange-500); font-weight: 700; }
  .pnote { padding: 16px; border-radius: var(--radius-md); background: var(--sand-100); color: var(--navy-600); }
  .ptags { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 14px; }
  .ptag { padding: 6px 12px; border-radius: var(--radius-full); border: 1px solid var(--border-light); font-weight: 600; font-size: 13px; line-height: 1; }
  .pauthor { display: flex; gap: 16px; padding: 24px; border-radius: var(--radius-xl); border: 1px solid var(--border-light); }
  .pauthor > div { display: flex; flex-direction: column; gap: 4px; }
  .pauthor :global(.pauthor__img) { flex: none; width: 64px; height: 64px; border-radius: 50%; }
  @media (min-width: 1024px) { .pbody { grid-template-columns: minmax(0, 1fr) 320px; gap: 80px; } .pbody__side { order: 2; position: sticky; top: 24px; } }
  @media (max-width: 767.98px) { .pfig :global(img) { aspect-ratio: 3 / 2; } .pbody { padding-block: 40px 60px; } .phead__share { display: none; } .pauthor { flex-direction: column; } }
  .pkeep { display: flex; flex-direction: column; gap: 40px; }
  .pkeep__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .rgrid-4 { list-style: none; padding: 0; display: grid; gap: 32px 24px; }
  @media (min-width: 768px) { .rgrid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .rgrid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
